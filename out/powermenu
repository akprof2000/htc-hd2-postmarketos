#!/usr/bin/env python3
"""Меню питания HTC HD2 — вызывается долгим нажатием красной кнопки."""
import fcntl
import subprocess
import tkinter as tk

BG, FG, DIM = "#101828", "#e8eef5", "#7c8794"

ACTIONS = [
    ("Выключить", "#a4262c", "poweroff"),
    ("Перезагрузка → Windows Mobile\n(экспериментально)", "#8a5a2e",
     "reboot"),
    ("Экран выключить", "#33415c",
     "sh -c 'echo 0 > /sys/class/leds/lcd-backlight/brightness'"),
    ("Перезапустить графику", "#5d5d3a", "/usr/local/bin/x-restart"),
]


def main():
    root = tk.Tk(className="powermenu")
    root.title("Питание")
    root.configure(bg=BG)
    root.geometry("480x740+0+0")
    root.attributes("-topmost", True)

    tk.Label(root, text="Питание", font=("DejaVu Sans", 22, "bold"),
             bg=BG, fg=FG).pack(pady=(30, 20))

    def run(cmd):
        root.destroy()
        subprocess.Popen(cmd, shell=True, start_new_session=True,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)

    # кнопки растягиваются на весь экран поровну — ничего не обрезается
    box = tk.Frame(root, bg=BG)
    box.pack(expand=True, fill="both", padx=16, pady=(0, 12))
    for name, color, cmd in ACTIONS + [("Отмена", "#33415c", None)]:
        b = tk.Button(box, text=name, font=("DejaVu Sans", 16, "bold"),
                      bg=color, fg="white", relief="flat", bd=0,
                      wraplength=400,
                      command=(root.destroy if cmd is None
                               else (lambda c=cmd: run(c))))
        b.pack(expand=True, fill="both", pady=6)

    root.after(300, lambda: root.geometry("480x740+0+0"))
    # само закроется, если про него забыли
    root.after(30000, root.destroy)
    root.mainloop()


if __name__ == "__main__":
    _l = open("/tmp/.powermenu.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    main()
