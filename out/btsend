#!/usr/bin/env python3
"""Передача файла по Bluetooth (OBEX Push) с HTC HD2.

Готовых obexftp/obexpushd в системе нет, поэтому говорим по OBEX сами:
RFCOMM-сокет -> CONNECT -> PUT (кусками) -> DISCONNECT.

    btsend <MAC> <файл> [канал]

Канал ищем через sdptool; если не вышло — пробуем 9, 12, 4 (обычные
каналы OBEX Push у телефонов).
"""
import os
import socket
import struct
import subprocess
import sys

AF_BLUETOOTH, BTPROTO_RFCOMM = 31, 3
OBEX_CONNECT, OBEX_DISCONNECT = 0x80, 0x81
OBEX_PUT_FINAL = 0x82
HI_NAME, HI_LENGTH, HI_BODY, HI_BODY_END = 0x01, 0xc3, 0x48, 0x49
MTU = 4096


def find_channel(mac):
    try:
        out = subprocess.run(["sdptool", "search", "--bdaddr", mac, "OPUSH"],
                             capture_output=True, text=True,
                             timeout=25).stdout
        want = False
        for ln in out.splitlines():
            if "RFCOMM" in ln:
                want = True
            elif want and "Channel:" in ln:
                return int(ln.split("Channel:")[1].strip())
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return None


def resp_name(code):
    return {0xa0: "OK", 0xc0: "запрос отклонён", 0xc3: "доступ запрещён",
            0xc6: "нет места", 0xd0: "внутренняя ошибка"}.get(
                code & 0x7f | 0x80, "код 0x%02x" % code)


def recv_pkt(s):
    head = b""
    while len(head) < 3:
        chunk = s.recv(3 - len(head))
        if not chunk:
            raise IOError("соединение закрыто")
        head += chunk
    code, ln = head[0], struct.unpack(">H", head[1:3])[0]
    body = b""
    while len(body) < ln - 3:
        chunk = s.recv(ln - 3 - len(body))
        if not chunk:
            break
        body += chunk
    return code, body


def send_file(mac, path, channel=None):
    name = os.path.basename(path)
    data = open(path, "rb").read()

    channels = [channel] if channel else []
    found = find_channel(mac)
    if found:
        channels.append(found)
    channels += [9, 12, 4, 10, 3]

    last_err = "нет ответа"
    for ch in [c for c in channels if c]:
        s = socket.socket(AF_BLUETOOTH, socket.SOCK_STREAM, BTPROTO_RFCOMM)
        s.settimeout(25)
        try:
            s.connect((mac, ch))
        except OSError as e:
            last_err = "канал %d: %s" % (ch, e)
            s.close()
            continue
        print("соединение по каналу %d" % ch)
        try:
            # CONNECT: версия 1.0, флаги 0, MTU
            pkt = struct.pack(">BHBBH", OBEX_CONNECT, 7, 0x10, 0x00, MTU)
            s.send(pkt)
            code, body = recv_pkt(s)
            if code != 0xa0:
                raise IOError("OBEX CONNECT: %s" % resp_name(code))
            peer_mtu = struct.unpack(">H", body[2:4])[0] if len(body) >= 4 \
                else MTU
            chunk = max(64, min(peer_mtu, MTU) - 64)

            uni = name.encode("utf-16-be") + b"\x00\x00"
            hdr = struct.pack(">BH", HI_NAME, 3 + len(uni)) + uni
            hdr += struct.pack(">BI", HI_LENGTH, len(data))

            off, first = 0, True
            while off < len(data):
                part = data[off:off + chunk]
                off += len(part)
                last = off >= len(data)
                hid = HI_BODY_END if last else HI_BODY
                h = struct.pack(">BH", hid, 3 + len(part)) + part
                payload = (hdr if first else b"") + h
                first = False
                op = OBEX_PUT_FINAL if last else 0x02
                s.send(struct.pack(">BH", op, 3 + len(payload)) + payload)
                code, _ = recv_pkt(s)
                if code not in (0x90, 0xa0):     # CONTINUE / OK
                    raise IOError("передача: %s" % resp_name(code))
                pct = off * 100 // max(len(data), 1)
                print("отправлено %d%%" % pct, flush=True)

            s.send(struct.pack(">BH", OBEX_DISCONNECT, 3))
            s.close()
            print("ФАЙЛ ПЕРЕДАН: %s (%d байт)" % (name, len(data)))
            return 0
        except (OSError, IOError, struct.error) as e:
            last_err = str(e)
            s.close()
    print("не удалось: %s" % last_err)
    return 1


if __name__ == "__main__":
    if len(sys.argv) < 3:
        print("использование: btsend <MAC> <файл> [канал]")
        sys.exit(2)
    ch = int(sys.argv[3]) if len(sys.argv) > 3 else None
    sys.exit(send_file(sys.argv[1], sys.argv[2], ch))
