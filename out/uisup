#!/bin/sh
# Супервизор IceMobile: домашний экран, кнопки, статус-полоска, шторка.
#
# ВАЖНО: все четыре службы теперь нативные (C++), поэтому в шаблонах
# поиска НЕТ слова python3 — иначе супервизор их «не видит» и плодит
# копии до бесконечности (так уже случилось: 74 копии домашнего экрана
# мигали друг поверх друга). Файлы блокировок НЕ удаляем: удаление
# ломает взаимное исключение, и копии снова начнут накапливаться.
while :; do
    pgrep -f '/usr/local/bin/home' >/dev/null || \
        { DISPLAY=:0 setsid /usr/local/bin/home >>/tmp/home.err 2>&1 & }

    pgrep -f '/usr/local/bin/keysd' >/dev/null || \
        { setsid /usr/local/bin/keysd >>/tmp/keysd.err 2>&1 & }

    pgrep -f '/usr/local/bin/statusbar' >/dev/null || \
        { DISPLAY=:0 setsid /usr/local/bin/statusbar >>/tmp/sbar.err 2>&1 & }

    # шторка — резидент с каналом /run/shade.fifo; без него тап по
    # полоске ничего не открывает, а запись в канал без читателя виснет
    pgrep -f '/usr/local/bin/shade --daemon' >/dev/null || \
        { DISPLAY=:0 setsid /usr/local/bin/shade --daemon \
            >>/tmp/shade.err 2>&1 & }

    sleep 5
done
