#!/bin/sh
# Супервизор IceMobile: домашний экран, кнопки, статус-полоска, шторка.
#
# ВАЖНО: все четыре службы нативные (C++), поэтому в шаблонах поиска НЕТ
# слова python3 — иначе супервизор их «не видит» и плодит копии до
# бесконечности (так уже случилось: 74 копии домашнего экрана мигали
# друг поверх друга). Файлы блокировок НЕ удаляем: удаление ломает
# взаимное исключение, и копии снова начнут накапливаться.
#
# ГРАБЛИ 04.09: одного pgrep мало — он находит и ЗОМБИ. После
# перезапуска графики шторка умерла («X connection broken»), осталась
# зомби-записью, супервизор считал её живой и не поднимал: полоска
# громкости пропала совсем, хотя звук подтверждения был слышен.
# Поэтому ниже проверяется состояние процесса, а службы запускаются
# через start-stop-daemon -b: он раздваивает процесс, родителем
# становится init, и зомби больше не остаются.

# жив ли хоть один НЕ зомби с таким именем.
# Именно -x по имени, а не -f по строке запуска: строка «/usr/local/bin/home»
# есть и в командной строке самого ui.start, и супервизор считал бы службу
# живой всегда.
alive() {
    for p in $(pgrep -x "$1" 2>/dev/null); do
        state=$(sed -n 's/^State:\t\(.\).*/\1/p' "/proc/$p/status" 2>/dev/null)
        [ -n "$state" ] && [ "$state" != "Z" ] && return 0
    done
    return 1
}

while :; do
    alive home || \
        DISPLAY=:0 start-stop-daemon -b -S -x /usr/local/bin/home

    alive keysd || \
        start-stop-daemon -b -S -x /usr/local/bin/keysd

    alive statusbar || \
        DISPLAY=:0 start-stop-daemon -b -S -x /usr/local/bin/statusbar

    # шторка — резидент с каналом /run/shade.fifo; без него тап по
    # полоске ничего не открывает, а запись в канал без читателя виснет
    alive shade || \
        DISPLAY=:0 start-stop-daemon -b -S -x /usr/local/bin/shade -- --daemon

    sleep 5
done
