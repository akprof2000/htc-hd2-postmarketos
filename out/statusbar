#!/usr/bin/env python3
"""Статусная полоска IceMobile — индикаторы как на смартфонах.

Слева: сигнал сотовой сети + тип, Wi-Fi.
Центр: часы (тап — на Домой).
Справа: ✉ непрочитанные SMS, ☎ пропущенные, ⏰ будильник, 🔦 фонарик,
батарея (% краснеет при <20, ⚡ на зарядке).
"""
import fcntl
import os
import subprocess
import time
import tkinter as tk

BG, FG, DIM, RED, OK = "#000000", "#e8eef5", "#9aa4b0", "#ef5350", "#66bb6a"
H = 24


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def count_lines(path):
    try:
        return len(open(path).read().splitlines())
    except OSError:
        return 0


def wifi_up():
    try:
        out = subprocess.run(["iw", "dev", "wlan0", "link"],
                             capture_output=True, text=True,
                             timeout=3).stdout
        return "Connected" in out
    except OSError:
        return False


def alarm_set():
    try:
        out = subprocess.run(["crontab", "-l"], capture_output=True,
                             text=True, timeout=3).stdout
        return "icemobile-alarm" in out
    except OSError:
        return False


def main():
    root = tk.Tk(className="statusbar")
    root.attributes("-topmost", True)
    root.configure(bg=BG)
    root.geometry("480x%d+0+0" % H)

    left = tk.Label(root, text="", font=("DejaVu Sans", 9), bg=BG, fg=DIM,
                    anchor="w", padx=3)
    left.pack(side="left")
    batt = tk.Label(root, text="", font=("DejaVu Sans", 9, "bold"),
                    bg=BG, fg=DIM, anchor="e", padx=3)
    batt.pack(side="right")
    icons = tk.Label(root, text="", font=("DejaVu Sans", 11), bg=BG,
                     fg=OK, anchor="e")
    icons.pack(side="right")
    # кнопка закрытия активного окна — красная, чтобы читалась как кнопка
    close = tk.Label(root, text="", font=("DejaVu Sans", 11, "bold"),
                     bg=BG, fg="white", padx=8)
    close.pack(side="right")
    title = tk.Label(root, text="", font=("DejaVu Sans", 11, "bold"),
                     bg=BG, fg=FG, anchor="w")
    title.pack(side="left", padx=(6, 0), fill="x", expand=True)

    def go_home(_e=None):
        subprocess.Popen("DISPLAY=:0 /usr/local/bin/shade", shell=True,
                         start_new_session=True,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    def close_win(_e=None):
        subprocess.Popen(
            "DISPLAY=:0 sh -c 'n=$(xdotool getactivewindow getwindowname "
            "2>/dev/null); case \"$n\" in Домой|statusbar) ;; *) "
            "wmctrl -c :ACTIVE: ;; esac'", shell=True,
            start_new_session=True, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL)
    close.bind("<Button-1>", close_win)
    for w in (root, left, batt, icons, title):
        w.bind("<Button-1>", go_home)

    slow = {"n": 0, "wifi": False, "alarm": False}

    def tick():
        # заголовок активного окна — вместо убранных рамок
        try:
            nm = subprocess.run(
                ["xdotool", "getactivewindow", "getwindowname"],
                capture_output=True, text=True, timeout=3,
                env=dict(os.environ, DISPLAY=":0")).stdout.strip()
        except (OSError, subprocess.TimeoutExpired):
            nm = ""
        if nm in ("statusbar", "Домой", ""):
            nm = ""
        title.config(text=nm[:16])
        if nm:
            close.config(text=" ✕ ", bg="#a4262c")
        else:
            close.config(text="", bg=BG)

        csq = read("/run/phone/csq")
        n = min(int(csq), 5) if csq.isdigit() else 0
        bars = "".join("▁▂▃▄▅"[i] if i < n else "·" for i in range(5))
        net = read("/run/phone/net").split()
        # медленные проверки — раз в 30 с
        if slow["n"] % 6 == 0:
            slow["wifi"] = wifi_up()
            slow["alarm"] = alarm_set()
        slow["n"] += 1
        wifi = " W" if slow["wifi"] else ""
        # когда открыто приложение — слева только полоски, чтобы влез
        # заголовок и кнопка «закрыть»
        if nm:
            left.config(text=bars)
        else:
            left.config(text="%s%s%s" % (bars,
                                         (" " + net[0][:4]) if net else "",
                                         wifi))

        # события: SMS, пропущенные, будильник, фонарик
        ev = []
        sms = count_lines("/run/phone/sms_new")
        if sms:
            ev.append("✉%d" % sms)
        missed = read("/run/phone/missed")
        if missed.isdigit() and int(missed) > 0:
            ev.append("☎%s" % missed)
        if slow["alarm"]:
            ev.append("⏰")
        if read("/sys/class/leds/flashlight/brightness", "0") not in ("", "0"):
            ev.append("🔦")
        icons.config(text=("  ".join(ev) + " ") if ev else "")

        cap = read("/sys/class/power_supply/battery/capacity", "?")
        chg = read("/sys/class/power_supply/battery/status")
        low = cap.isdigit() and int(cap) <= 20 and chg == "Discharging"
        batt.config(text="%s%s%%" % (
            "⚡" if chg in ("Charging", "Full") else "", cap),
            fg=RED if low else DIM)

        root.attributes("-topmost", True)
        root.lift()                      # окна WM иначе накрывают полоску
        root.geometry("480x%d+0+0" % H)
        root.after(5000, tick)

    tick()
    root.mainloop()


if __name__ == "__main__":
    _l = open("/tmp/.statusbar.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    main()
