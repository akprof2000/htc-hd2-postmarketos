#!/usr/bin/env python3
"""Статусная полоска IceMobile: всегда сверху — часы, сеть, батарея.

Заменяет нижнюю панель задач. Окно override-redirect высотой 24px,
поверх всех приложений. Тап по полоске поднимает «Домой».
"""
import fcntl
import subprocess
import time
import tkinter as tk

BG, FG, DIM = "#000000", "#e8eef5", "#9aa4b0"
H = 24


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def main():
    root = tk.Tk(className="statusbar")
    root.overrideredirect(True)
    root.attributes("-topmost", True)
    root.configure(bg=BG)
    root.geometry("480x%d+0+0" % H)

    left = tk.Label(root, text="", font=("DejaVu Sans", 11), bg=BG, fg=DIM,
                    anchor="w", padx=8)
    left.pack(side="left")
    right = tk.Label(root, text="", font=("DejaVu Sans", 11), bg=BG, fg=DIM,
                     anchor="e", padx=8)
    right.pack(side="right")
    clock = tk.Label(root, text="", font=("DejaVu Sans", 12, "bold"),
                     bg=BG, fg=FG)
    clock.pack(expand=True)

    def go_home(_e=None):
        subprocess.Popen("DISPLAY=:0 wmctrl -a 'Домой'", shell=True,
                         start_new_session=True,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    for w in (root, left, right, clock):
        w.bind("<Button-1>", go_home)

    def tick():
        clock.config(text=time.strftime("%H:%M"))
        csq = read("/run/phone/csq")
        n = min(int(csq), 5) if csq.isdigit() else 0
        bars = "".join("▁▂▃▄▅"[i] if i < n else "·" for i in range(5))
        net = read("/run/phone/net").split()
        left.config(text="%s %s" % (bars, net[0] if net else ""))
        cap = read("/sys/class/power_supply/battery/capacity", "?")
        chg = read("/sys/class/power_supply/battery/status")
        right.config(text="%s%s%%" % (
            "⚡" if chg in ("Charging", "Full") else "", cap))
        root.attributes("-topmost", True)
        root.geometry("480x%d+0+0" % H)
        root.after(5000, tick)

    tick()
    root.mainloop()


if __name__ == "__main__":
    _l = open("/tmp/.statusbar.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    main()
