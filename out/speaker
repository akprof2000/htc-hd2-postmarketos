#!/bin/sh
# Звук плеера на Bluetooth-колонку.
#
#     speaker on [MAC]    — включить: bta2dp читает PCM из канала
#                           /run/a2dp.pcm, Rockbox пишет туда (см.
#                           правку pcm-sdl.c); адрес по умолчанию —
#                           последний из /root/.btkeys
#     speaker off         — выключить, звук обратно в динамик
#     speaker status
#
# bta2dp открывает канал сам, на чтение-запись, поэтому порядок запуска
# не важен и паузы плеера не рвут соединение.
# bta2dp сам дозванивается до колонки; если она спит — ему нужен
# режим сопряжения на колонке или просто её включение.
SINK=/run/a2dp.sink
FIFO=/run/a2dp.pcm
LOG=/tmp/a2dp-speaker.log
LOOP=/run/a2dp.loop

case "$1" in
on)
    MAC="$2"
    [ -z "$MAC" ] && MAC=$(tail -1 /root/.btkeys 2>/dev/null | cut -d' ' -f1)
    [ -z "$MAC" ] && { echo "нет адреса колонки (нет ключей в /root/.btkeys)"; exit 1; }
    [ -p "$FIFO" ] || mkfifo "$FIFO"
    echo "$MAC" > "$SINK"
    # прежний цикл и его bta2dp — адресно, по pid из файла: обычный
    # pkill оставлял старый цикл в живых (он успевал увидеть новый
    # файл-переключатель), и два bta2dp дрались за колонку
    [ -f "$LOOP" ] && kill "$(cat "$LOOP")" 2>/dev/null
    pkill -x btagent 2>/dev/null
    pkill -x bta2dp 2>/dev/null
    sleep 1
    # Держатель канала: открывает его на чтение-запись и просто живёт.
    # Без него в промежутке между попытками bta2dp у канала не остаётся
    # читателя, и плеер умирает от SIGPIPE на первой же записи —
    # именно так он и пропадал.
    setsid sh -c "exec 3<>$FIFO; while [ -f $SINK ]; do sleep 5; done"         </dev/null >/dev/null 2>&1 &
    # читатель канала; работает, пока файл-переключатель указывает на
    # этот же цикл; по концу потока запускается снова
    setsid sh -c "echo \$\$ > $LOOP
        while [ -f $SINK ] && [ \"\$(cat $LOOP 2>/dev/null)\" = \"\$\$\" ]; do
            BTA2DP_PSRM=0 BTA2DP_ALTADDR=1 BTA2DP_NOAUTH=1 /usr/local/bin/bta2dp $MAC $FIFO
            sleep 2
        done
        setsid /usr/local/bin/btagent 0000 </dev/null >/dev/null 2>&1 &" </dev/null >"$LOG" 2>&1 &
    # плеер перезапускаем, чтобы взял новый выход
    pkill -x rockbox 2>/dev/null
    i=0; while pgrep -x rockbox >/dev/null && [ $i -lt 40 ]; do i=$((i+1)); sleep 0.5; done
    DISPLAY=:0 /usr/local/bin/rockbox-app >/dev/null 2>&1 &
    echo "колонка $MAC: включена, плеер перезапущен"
    ;;
off)
    rm -f "$SINK"
    [ -f "$LOOP" ] && kill "$(cat "$LOOP")" 2>/dev/null; rm -f "$LOOP"
    pkill -x bta2dp 2>/dev/null
    pkill -x rockbox 2>/dev/null
    i=0; while pgrep -x rockbox >/dev/null && [ $i -lt 40 ]; do i=$((i+1)); sleep 0.5; done
    pgrep -x btagent >/dev/null || setsid /usr/local/bin/btagent 0000 </dev/null >/dev/null 2>&1 &
    DISPLAY=:0 /usr/local/bin/rockbox-app >/dev/null 2>&1 &
    echo "колонка выключена, звук в динамик"
    ;;
status)
    if [ -f "$SINK" ]; then
        echo "колонка $(cat $SINK): включена; bta2dp $(pgrep -x bta2dp >/dev/null && echo работает || echo 'ждёт плеер')"
        tail -3 "$LOG" 2>/dev/null
    else
        echo "звук в динамик"
    fi
    ;;
*)
    echo "speaker on [MAC] | off | status"
    ;;
esac
