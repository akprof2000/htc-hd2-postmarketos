#!/usr/bin/env python3
"""SMS для HTC HD2.

Со звуком в разговоре не сложилось, зато сообщения работают полностью —
и делают аппарат настоящим средством связи.

Читает список с SIM через демон (AT+CMGL), отправляет через AT+CMGS.
Как и звонилка, с модемом напрямую не разговаривает: канал у демона.
"""
import os
import re
import subprocess
import time
import tkinter as tk
from tkinter import scrolledtext

RUN = "/run/phone"
CMD = os.path.join(RUN, "cmd")
LOG = os.path.join(RUN, "log")

BG     = "#101418"
FG     = "#e8eef5"
DIM    = "#7c8794"
ACCENT = "#2e7d32"
FIELD  = "#1c2530"


def keyboard(show=True):
    """Экранная клавиатура. Без неё в поля не набрать: физической нет."""
    if show:
        if subprocess.run(["pgrep", "svkbd"],
                          stdout=subprocess.DEVNULL).returncode != 0:
            subprocess.run(["/usr/local/bin/kbd"],
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
    else:
        subprocess.run(["pkill", "svkbd"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def send_at(at):
    try:
        with open(CMD, "w") as f:
            f.write(at + "\n")
    except OSError:
        pass


def log_tail(seconds=3.0):
    """Строки, пришедшие от модема за последние N секунд."""
    try:
        lines = open(LOG).readlines()
    except OSError:
        return []
    cutoff = time.time() - seconds
    out = []
    for ln in lines[-400:]:
        parts = ln.split(None, 2)
        if len(parts) < 3 or parts[1] != "<-":
            continue
        try:
            t = time.strptime(parts[0], "%H:%M:%S")
        except ValueError:
            continue
        now = time.localtime()
        stamp = time.mktime((now.tm_year, now.tm_mon, now.tm_mday,
                             t.tm_hour, t.tm_min, t.tm_sec, 0, 0, -1))
        if stamp >= cutoff:
            out.append(parts[2].rstrip())
    return out


class Sms:
    def __init__(self, root):
        self.root = root
        root.title("Сообщения")
        root.configure(bg=BG)
        root.geometry("480x488+0+24")

        tk.Label(root, text="Кому (номер)", font=("DejaVu Sans", 11),
                 bg=BG, fg=DIM, anchor="w", padx=10).pack(fill="x", pady=(8, 0))
        self.to = tk.Entry(root, font=("DejaVu Sans", 16), bg=FIELD, fg=FG,
                           insertbackground=FG, relief="flat")
        self.to.pack(fill="x", padx=10, pady=4, ipady=6)

        tk.Label(root, text="Текст", font=("DejaVu Sans", 11),
                 bg=BG, fg=DIM, anchor="w", padx=10).pack(fill="x", pady=(6, 0))
        self.text = tk.Text(root, font=("DejaVu Sans", 14), height=5,
                            bg=FIELD, fg=FG, insertbackground=FG, relief="flat",
                            wrap="word")
        self.text.pack(fill="x", padx=10, pady=4)

        bar = tk.Frame(root, bg=BG)
        bar.pack(fill="x", padx=10, pady=6)
        tk.Button(bar, text="Отправить", font=("DejaVu Sans", 14, "bold"),
                  bg=ACCENT, fg="white", relief="flat", bd=0, height=2,
                  command=self.send).pack(side="left", expand=True, fill="both",
                                          padx=(0, 4))
        tk.Button(bar, text="Обновить", font=("DejaVu Sans", 14),
                  bg=FIELD, fg=FG, relief="flat", bd=0, height=2,
                  command=self.refresh).pack(side="left", expand=True,
                                             fill="both", padx=4)
        tk.Button(bar, text="⌨", font=("DejaVu Sans", 14),
                  bg=FIELD, fg=FG, relief="flat", bd=0, height=2,
                  command=self.toggle_kbd).pack(side="left", expand=True,
                                                fill="both", padx=(4, 0))

        self.status = tk.Label(root, text="", font=("DejaVu Sans", 10),
                               bg=BG, fg=DIM, anchor="w", padx=10)
        self.status.pack(fill="x")

        tk.Label(root, text="Входящие", font=("DejaVu Sans", 11),
                 bg=BG, fg=DIM, anchor="w", padx=10).pack(fill="x", pady=(8, 0))
        self.list = scrolledtext.ScrolledText(root, font=("DejaVu Sans", 11),
                                              bg=FIELD, fg=FG, relief="flat",
                                              wrap="word")
        self.list.pack(expand=True, fill="both", padx=10, pady=(4, 10))

        self.kbd = True
        keyboard(True)
        self.to.focus_set()
        self.root.after(300, self.fix_place)
        self.root.after(1200, self.fix_place)
        self.refresh()

    def fix_place(self):
        """IceWM ставит окно со сдвигом — возвращаем в левый верхний угол,
        иначе правый край уезжает за экран."""
        self.root.geometry("480x488+0+24")

    def toggle_kbd(self):
        self.kbd = not self.kbd
        keyboard(self.kbd)

    def send(self):
        num = self.to.get().strip()
        body = self.text.get("1.0", "end").strip()
        if not num or not body:
            self.status.config(text="нужен номер и текст", fg="#ef5350")
            return
        # AT+CMGS ждёт текст, затем Ctrl-Z (0x1A)
        send_at('AT+CMGS="%s"' % num)
        time.sleep(1.0)
        send_at(body + "\x1a")
        self.status.config(text="отправляется…", fg="#ffa726")
        self.root.after(6000, self.check_sent)

    def check_sent(self):
        recent = log_tail(8)
        if any(l.startswith("+CMGS") for l in recent):
            self.status.config(text="отправлено", fg="#66bb6a")
            self.text.delete("1.0", "end")
        elif any("ERROR" in l for l in recent):
            self.status.config(text="ошибка отправки", fg="#ef5350")
        else:
            self.status.config(text="ответа нет", fg=DIM)

    def refresh(self):
        try:                             # входящие просмотрены
            open(os.path.join(RUN, "sms_new"), "w").close()
        except OSError:
            pass
        self.status.config(text="читаю сообщения…", fg=DIM)
        send_at("AT+CMGF=1")
        time.sleep(0.4)
        send_at('AT+CMGL="ALL"')
        self.root.after(4000, self.show)

    @staticmethod
    def dehex(s):
        """Модем отдаёт текст и номер шестнадцатеричным потоком:
        кириллица — UCS2 (4 знака на букву), номера — ASCII-hex."""
        s = s.strip()
        if not s or not re.fullmatch(r'[0-9A-Fa-f]+', s) or len(s) % 2:
            return s
        raw = bytes.fromhex(s)
        # UCS2: чётные байты в основном 0x00/0x04 (латиница/кириллица)
        if len(raw) % 2 == 0 and raw[::2].count(0) + raw[::2].count(4) \
                >= len(raw) // 4:
            try:
                return raw.decode("utf-16-be").replace("\r", "")
            except UnicodeDecodeError:
                pass
        if all(32 <= b < 127 for b in raw):
            return raw.decode("ascii")
        return s

    def show(self):
        lines = log_tail(6)
        msgs = []
        cur = None
        for ln in lines:
            m = re.match(r'\+CMGL:\s*(\d+),"([^"]*)","([^"]*)",[^,]*,"([^"]*)"',
                         ln)
            if m:
                cur = {"idx": m.group(1), "from": self.dehex(m.group(3)),
                       "when": m.group(4), "body": ""}
                msgs.append(cur)
            elif cur is not None and ln != "OK":
                cur["body"] += self.dehex(ln)
        # длинное SMS приходит кусками подряд от одного номера — склеиваем
        merged = []
        for m in msgs:
            if merged and merged[-1]["from"] == m["from"] and \
                    int(m["idx"]) == merged[-1]["lastidx"] + 1:
                merged[-1]["body"] += m["body"]
                merged[-1]["lastidx"] = int(m["idx"])
            else:
                m["lastidx"] = int(m["idx"])
                merged.append(m)
        self.list.delete("1.0", "end")
        if not merged:
            self.list.insert("end", "нет сообщений\n")
        for m in merged:
            self.list.insert("end", "%s  ·  %s\n%s\n\n"
                             % (m["from"], m["when"], m["body"]))
        self.status.config(text="сообщений: %d" % len(merged), fg=DIM)


if __name__ == "__main__":
    root = tk.Tk()
    Sms(root)
    root.mainloop()
