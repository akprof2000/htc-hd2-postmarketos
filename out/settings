#!/usr/bin/env python3
"""Настройки HTC HD2 — центр управления. Только проверенные виджеты
(Label с bind): Scale/Button в этом Tk рисуются пустыми."""
import fcntl
import subprocess
import tkinter as tk

BG, FG, DIM, KEY, ACC = "#101828", "#e8eef5", "#7c8794", "#2a3a55", "#1f7a33"
BL = "/sys/class/leds/lcd-backlight/brightness"


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def at(cmd):
    try:
        with open("/run/phone/cmd", "w") as f:
            f.write(cmd + "\n")
    except OSError:
        pass


def buzz():
    try:
        with open("/sys/class/timed_output/vibrator/enable", "w") as f:
            f.write("30")
    except OSError:
        pass


class Settings:
    def __init__(self, root):
        self.root = root
        root.title("Настройки")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")

        tk.Label(root, text="Настройки", font=("DejaVu Sans", 18, "bold"),
                 bg=BG, fg=FG).pack(pady=(10, 6))
        self.body = tk.Frame(root, bg=BG)
        self.body.pack(expand=True, fill="both", padx=12)

        # яркость
        try:
            self.brightness = int(read(BL, "180") or 180)
        except ValueError:
            self.brightness = 180
        self.b_lbl = self.stepper("Яркость", self.bright_delta)
        # громкость
        try:
            self.volume = int(read("/run/phone/vol", "70") or 70)
        except ValueError:
            self.volume = 70
        self.v_lbl = self.stepper("Громкость", self.vol_delta)
        self.show_vals()

        # переключатели-плитки
        row = tk.Frame(self.body, bg=BG)
        row.pack(fill="x", pady=6)
        self.tile(row, "Сеть 2G — звонки",
                  lambda: at('AT+COPS=1,2,"25002",0'))
        row2 = tk.Frame(self.body, bg=BG)
        row2.pack(fill="x", pady=2)
        self.tile(row2, "Сеть 3G — интернет", lambda: at("AT+COPS=0"))
        row3 = tk.Frame(self.body, bg=BG)
        row3.pack(fill="x", pady=2)
        self.tile(row3, "Сбросить значки уведомлений", self.clear_marks)

        tk.Label(self.body, text="Состояние",
                 font=("DejaVu Sans", 12, "bold"), bg=BG, fg=DIM,
                 anchor="w").pack(fill="x", pady=(10, 2))
        self.info = tk.Label(self.body, text="", font=("DejaVu Sans", 11),
                             bg="#1c2a40", fg=FG, anchor="w",
                             justify="left", padx=10, pady=8,
                             wraplength=430)
        self.info.pack(fill="x")
        self.refresh()
        root.after(300, lambda: root.geometry("480x776+0+24"))

    # ── степпер: [−]  Название: значение  [+] ─────────────────────────
    def stepper(self, name, cb):
        fr = tk.Frame(self.body, bg=BG)
        fr.pack(fill="x", pady=5)
        minus = tk.Label(fr, text="−", font=("DejaVu Sans", 22, "bold"),
                         bg=KEY, fg="white", width=3, pady=8)
        minus.pack(side="left", padx=(0, 4))
        minus.bind("<Button-1>", lambda e: (buzz(), cb(-1)))
        val = tk.Label(fr, text=name, font=("DejaVu Sans", 14, "bold"),
                       bg=BG, fg=FG)
        val.pack(side="left", expand=True)
        plus = tk.Label(fr, text="+", font=("DejaVu Sans", 22, "bold"),
                        bg=KEY, fg="white", width=3, pady=8)
        plus.pack(side="right", padx=(4, 0))
        plus.bind("<Button-1>", lambda e: (buzz(), cb(+1)))
        return val

    def bright_delta(self, d):
        self.brightness = max(10, min(255, self.brightness + d * 35))
        try:
            with open(BL, "w") as f:
                f.write(str(self.brightness))
        except OSError:
            pass
        self.show_vals()

    def vol_delta(self, d):
        self.volume = max(0, min(100, self.volume + d * 10))
        at("@vol %d" % self.volume)
        self.show_vals()

    def show_vals(self):
        self.b_lbl.config(text="Яркость: %d%%"
                          % round(self.brightness * 100 / 255))
        self.v_lbl.config(text="Громкость: %d%%" % self.volume)

    def tile(self, parent, text, cb):
        t = tk.Label(parent, text=text, font=("DejaVu Sans", 12, "bold"),
                     bg=KEY, fg="white", pady=14, wraplength=430)
        t.pack(expand=True, fill="x")

        def go(_e):
            buzz()
            t.config(bg=ACC)
            t.after(600, lambda: t.config(bg=KEY))
            cb()
        t.bind("<Button-1>", go)

    def clear_marks(self):
        for f in ("/run/phone/sms_new", "/run/phone/missed"):
            try:
                open(f, "w").close()
            except OSError:
                pass

    def refresh(self):
        up = float(read("/proc/uptime", "0 0").split()[0])
        mem = {}
        for ln in open("/proc/meminfo"):
            k, v = ln.split(":", 1)
            mem[k] = int(v.split()[0])
        free = (mem["MemFree"] + mem.get("Cached", 0)) // 1024
        self.info.config(text=(
            "Сеть: %s · %s дБм\nБатарея: %s%% (%s)\n"
            "Память: свободно %d МБ\nРаботает: %d ч %02d мин"
            % (read("/run/phone/net", "—"), read("/run/phone/dbm", "?"),
               read("/sys/class/power_supply/battery/capacity", "?"),
               {"Charging": "заряжается", "Full": "заряжена",
                "Discharging": "разряжается"}.get(
                   read("/sys/class/power_supply/battery/status"), "?"),
               free, up // 3600, up % 3600 // 60)))
        self.root.after(5000, self.refresh)


if __name__ == "__main__":
    _l = open("/tmp/.settings.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="settingsapp")
    Settings(root)
    root.mainloop()
