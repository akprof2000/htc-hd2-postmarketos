#!/usr/bin/env python3
"""Шторка уведомлений IceMobile — выезжает по тапу на статус-полоске.

Быстрые тумблеры (Wi-Fi, фонарик, 2G/3G, звук, яркость) + уведомления:
пропущенные, SMS, будильник, последние события. Тумблеры подсвечены,
если функция активна. Всё на Label (Button в этом Tk пустые).
"""
import fcntl
import subprocess
import time
import tkinter as tk

BG, FG, DIM, KEY, ACC = "#0d1420", "#e8eef5", "#7c8794", "#22314a", "#1f7a33"
TORCH = "/sys/class/leds/flashlight/brightness"
BL = "/sys/class/leds/lcd-backlight/brightness"


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def at(cmd):
    try:
        with open("/run/phone/cmd", "w") as f:
            f.write(cmd + "\n")
    except OSError:
        pass


def sh(cmd):
    subprocess.Popen(cmd, shell=True, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def buzz():
    try:
        with open("/sys/class/timed_output/vibrator/enable", "w") as f:
            f.write("30")
    except OSError:
        pass


def wifi_on():
    try:
        out = subprocess.run(["iw", "dev", "wlan0", "link"],
                             capture_output=True, text=True,
                             timeout=3).stdout
        return "Connected" in out
    except OSError:
        return False


class Shade:
    def __init__(self, root):
        self.root = root
        root.title("Шторка")
        root.configure(bg=BG)
        self.h = 40
        root.geometry("480x40+0+0")

        top = tk.Frame(root, bg=BG)
        top.pack(fill="x", pady=(28, 4))
        tk.Label(top, text=time.strftime("%H:%M"),
                 font=("DejaVu Sans", 26, "bold"), bg=BG, fg=FG
                 ).pack(side="left", padx=14)
        wd = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"][
            int(time.strftime("%w")) - 1]
        tk.Label(top, text="%s, %s" % (wd, time.strftime("%d.%m")),
                 font=("DejaVu Sans", 13), bg=BG, fg=DIM
                 ).pack(side="left")
        bt = read("/sys/class/power_supply/battery/capacity", "?")
        tk.Label(top, text="🔋 %s%%" % bt, font=("DejaVu Sans", 13),
                 bg=BG, fg=DIM).pack(side="right", padx=14)

        # ── быстрые тумблеры ──────────────────────────────────────────
        self.tiles = {}
        grid = tk.Frame(root, bg=BG)
        grid.pack(fill="x", padx=10, pady=6)
        items = [
            ("wifi", "Wi-Fi", self.t_wifi),
            ("torch", "Фонарик", self.t_torch),
            ("mute", "Звук", self.t_mute),
            ("2g", "2G", lambda: (at('AT+COPS=1,2,"25002",0'),
                                  self.mark("2g"))),
            ("3g", "3G", lambda: (at("AT+COPS=0"), self.mark("3g"))),
            ("bright", "Ярче", lambda: sh("/usr/local/bin/backlight +")),
            ("dim", "Темнее", lambda: sh("/usr/local/bin/backlight -")),
            ("cam", "Камера", lambda: (sh("DISPLAY=:0 "
                                          "/usr/local/bin/camera-app"),
                                       self.close())),
        ]
        for i, (key, name, cb) in enumerate(items):
            t = tk.Label(grid, text=name, font=("DejaVu Sans", 11, "bold"),
                         bg=KEY, fg="white", width=10, pady=16)
            t.grid(row=i // 4, column=i % 4, padx=3, pady=3, sticky="nsew")
            t.bind("<Button-1>", lambda e, c=cb: (buzz(), c()))
            self.tiles[key] = t
        for c in range(4):
            grid.columnconfigure(c, weight=1)

        # ── уведомления ───────────────────────────────────────────────
        tk.Label(root, text="Уведомления", font=("DejaVu Sans", 12, "bold"),
                 bg=BG, fg=DIM, anchor="w", padx=14).pack(fill="x",
                                                          pady=(8, 2))
        self.notif = tk.Frame(root, bg=BG)
        self.notif.pack(expand=True, fill="both", padx=10)

        close = tk.Label(root, text="▲  закрыть", font=("DejaVu Sans", 13),
                         bg=KEY, fg=DIM, pady=10)
        close.pack(fill="x", side="bottom")
        close.bind("<Button-1>", lambda e: self.close())
        root.bind("<Escape>", lambda e: self.close())

        self.fill()
        self.paint()
        self.slide()

    def slide(self):
        # анимация выезда; в конце — самозакрытие через 20 с бездействия
        if self.h < 780:
            self.h = min(self.h + 140, 780)
            self.root.geometry("480x%d+0+0" % self.h)
            self.root.after(25, self.slide)
        else:
            self.root.after(20000, self.close)

    def close(self):
        try:
            self.root.destroy()
        except tk.TclError:
            pass

    # ── тумблеры ──────────────────────────────────────────────────────
    def paint(self):
        self.tiles["wifi"].config(bg=ACC if wifi_on() else KEY)
        self.tiles["torch"].config(
            bg=ACC if read(TORCH, "0") not in ("", "0") else KEY)
        vol = read("/run/phone/vol", "70")
        self.tiles["mute"].config(
            bg=KEY if vol == "0" else ACC,
            text="Тихо" if vol == "0" else "Звук")
        net = read("/run/phone/net", "")
        self.tiles["2g"].config(bg=ACC if net.startswith(("EDGE", "GSM"))
                                else KEY)
        self.tiles["3g"].config(bg=ACC if net.startswith("3G") else KEY)

    def mark(self, key):
        self.tiles[key].config(bg=ACC)
        self.root.after(3000, self.paint)

    def t_wifi(self):
        if wifi_on():
            sh("ifconfig wlan0 down")
        else:
            sh("ifconfig wlan0 up")
        self.root.after(2500, self.paint)

    def t_torch(self):
        sh("/usr/local/bin/torch")
        self.root.after(500, self.paint)

    def t_mute(self):
        vol = read("/run/phone/vol", "70")
        if vol == "0":
            at("@vol 70")
            try:
                open("/run/phone/vol", "w").write("70")
            except OSError:
                pass
        else:
            at("@vol 0")
            try:
                open("/run/phone/vol", "w").write("0")
            except OSError:
                pass
        self.root.after(300, self.paint)

    # ── уведомления ───────────────────────────────────────────────────
    def note(self, icon, text, cb=None):
        row = tk.Label(self.notif, text="%s  %s" % (icon, text),
                       font=("DejaVu Sans", 12), bg="#182238", fg=FG,
                       anchor="w", padx=12, pady=10, wraplength=430,
                       justify="left")
        row.pack(fill="x", pady=3)
        if cb:
            row.bind("<Button-1>", lambda e: (cb(), self.close()))

    def fill(self):
        n = 0
        missed = read("/run/phone/missed")
        if missed.isdigit() and int(missed) > 0:
            # последние пропущенные номера из журнала
            nums = []
            try:
                for ln in open("/var/lib/phone/history"
                               ).read().splitlines()[::-1]:
                    p = ln.split(";")
                    if len(p) >= 4 and p[3] == "missed":
                        nums.append(p[2])
                    if len(nums) >= int(missed):
                        break
            except OSError:
                pass
            self.note("☎", "Пропущенные вызовы (%s): %s" %
                      (missed, ", ".join(nums[:3]) or "—"),
                      lambda: sh("DISPLAY=:0 /usr/local/bin/phone-gui"))
            n += 1
        sms = read("/run/phone/sms_new")
        cnt = len(sms.splitlines()) if sms else 0
        if cnt:
            self.note("✉", "Новых SMS: %d — открыть Сообщения" % cnt,
                      lambda: sh("DISPLAY=:0 /usr/local/bin/phone-sms"))
            n += 1
        try:
            out = subprocess.run(["crontab", "-l"], capture_output=True,
                                 text=True, timeout=3).stdout
            for ln in out.splitlines():
                if "icemobile-alarm" in ln:
                    p = ln.split()
                    self.note("⏰", "Будильник на %02d:%02d"
                              % (int(p[1]), int(p[0])),
                              lambda: sh("DISPLAY=:0 "
                                         "/usr/local/bin/clock-app"))
                    n += 1
        except (OSError, ValueError, IndexError):
            pass
        cap = read("/sys/class/power_supply/battery/capacity", "")
        if cap.isdigit() and int(cap) <= 20:
            self.note("🪫", "Заряд батареи низкий: %s%%" % cap)
            n += 1
        if not n:
            self.note("·", "Нет новых уведомлений")


if __name__ == "__main__":
    _l = open("/tmp/.shade.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="shade")
    Shade(root)
    root.mainloop()
