#!/usr/bin/env python3
"""FM-радио HTC HD2 (приёмник в BCM4329, антенна — кабель наушников).

Регистры приёмника — через /usr/local/bin/fmctl (vendor-команды HCI),
звук — ioctl AUDIO_START_FM(37) на /dev/msm_audio_ctl: аналоговая петля
FM -> кодек -> наушники.

Важно: приёмник живёт в том же чипе, что Bluetooth, и оживает только
после свежей инициализации чипа (btsetup) — приложение делает её само.
Кнопки — Label с bind: настоящие tk.Button в этом Tk рисуются пустыми.
"""
import fcntl
import os
import runpy
import struct
import sys
import subprocess
import threading
import tkinter as tk

BG, FG, DIM, KEY, ACC, RED = ("#101828", "#e8eef5", "#7c8794", "#1c2a40",
                              "#1f7a33", "#a4262c")
PRESETS_FILE = "/root/.fm-presets"
STATIONS_FILE = "/root/.fm-stations"
DEV_HEADSET = 0x107ac8a
BAND = (87500, 108000)
R_RSSI, R_FLAG0 = 0x0f, 0x12


def audio_ioctl(n, arg=0):
    code = (1 << 30) | (4 << 16) | (ord("a") << 8) | n
    fd = os.open("/dev/msm_audio_ctl", os.O_RDWR)
    try:
        fcntl.ioctl(fd, code, struct.pack("I", arg))
    finally:
        os.close(fd)


def fm_flag(val):
    """/sys/class/htc_accessory/fm/flag: ядро требует ровно len+1 байт."""
    try:
        fd = os.open("/sys/class/htc_accessory/fm/flag", os.O_WRONLY)
        try:
            os.write(fd, (val + chr(10)).encode())
        finally:
            os.close(fd)
    except OSError:
        pass


def bt_up():
    try:
        out = subprocess.run(["hciconfig", "hci0"], capture_output=True,
                             text=True, timeout=5).stdout
        return "UP RUNNING" in out
    except (OSError, subprocess.SubprocessError):
        return False


def headset_in():
    try:
        return int(open("/sys/class/switch/h2w/state").read().strip()) & 3
    except (OSError, ValueError):
        return 0


def peaks(profile, min_rise=3, min_gap=400):
    """Вершины профиля -> частоты станций.

    profile: [(кГц, уровень)]. Станция шире шага сканирования, поэтому
    берём самые сильные точки и сливаем всё, что ближе min_gap.
    """
    if not profile:
        return []
    noise = min(v for _, v in profile)
    cand = sorted(((v, k) for k, v in profile if v >= noise + min_rise),
                  reverse=True)
    out = []
    for v, k in cand:
        if all(abs(k - k2) >= min_gap for _, k2 in out):
            out.append((v, k))
    return out


class Radio:
    def __init__(self, root):
        self.root = root
        root.title("Радио")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")
        self.fm = runpy.run_path("/usr/local/bin/fmctl")
        self.lock = threading.Lock()      # сокет HCI один: доступ по очереди
        self.s = None
        self.on = False
        self.scanning = False
        self.vol = 100
        try:
            self.khz = int(open("/run/fm").read().strip()) or 96800
        except (OSError, ValueError):
            self.khz = 96800
        # единый список станций; старые пресеты подхватываем один раз
        self.stations = sorted(set(
            k for k in self.load_list(STATIONS_FILE, 60) if k) |
            set(k for k in self.load_list(PRESETS_FILE, 6) if k))
        self.page = 0

        self.freq_lbl = tk.Label(root, text="—", bg=BG, fg=FG,
                                 font=("DejaVu Sans", 54, "bold"))
        self.freq_lbl.pack(pady=(20, 0))
        self.info = tk.Label(root, text="наушники — это антенна", bg=BG,
                             fg=DIM, font=("DejaVu Sans", 12))
        self.info.pack()

        self.scale = tk.Canvas(root, width=460, height=56, bg=KEY,
                               highlightthickness=0)
        self.scale.pack(pady=(6, 8))
        self.scale.bind("<Button-1>", self.tap_scale)
        self.scale.bind("<B1-Motion>", self.tap_scale)

        row = tk.Frame(root, bg=BG)
        row.pack(fill="x", padx=10)
        self.key(row, "◀◀", lambda: self.hop(-1))
        self.key(row, "◀", lambda: self.tune(self.khz - 100))
        self.key(row, "▶", lambda: self.tune(self.khz + 100))
        self.key(row, "▶▶", lambda: self.hop(+1))

        row2 = tk.Frame(root, bg=BG)
        row2.pack(fill="x", padx=10, pady=(6, 0))
        self.scan_btn = self.key(row2, "Обзор диапазона", self.scan_start)
        self.key(row2, "Частота", self.keypad)

        row3 = tk.Frame(root, bg=BG)
        row3.pack(fill="x", padx=10, pady=(10, 0))
        self.key(row3, "◀", lambda: self.flip(-1))
        self.key(row3, "+ запомнить", self.remember)
        self.key(row3, "▶", lambda: self.flip(+1))
        self.key(row3, "очистить", self.clear_all)
        self.hint = tk.Label(root, text="", bg=BG, fg=DIM,
                             font=("DejaVu Sans", 10))
        self.hint.pack(pady=(6, 2))
        grid = tk.Frame(root, bg=BG)
        grid.pack(fill="x", padx=10)
        self.pbtn = []
        for i in range(6):
            b = tk.Label(grid, text="", bg=KEY, fg=FG, pady=11,
                         font=("DejaVu Sans", 14, "bold"))
            b.grid(row=i // 3, column=i % 3, padx=3, pady=3, sticky="nsew")
            b.bind("<ButtonPress-1>", lambda e, i=i: self.press(i))
            b.bind("<ButtonRelease-1>", lambda e, i=i: self.release(i))
            self.pbtn.append(b)
        for c in range(3):
            grid.columnconfigure(c, weight=1)

        vol = tk.Frame(root, bg=BG)
        vol.pack(fill="x", padx=10, pady=(12, 0))
        self.key(vol, "тише", lambda: self.volume(-15))
        self.key(vol, "громче", lambda: self.volume(+15))

        self.power = tk.Label(root, text="", bg=ACC, fg="white", pady=15,
                              font=("DejaVu Sans", 17, "bold"))
        self.power.pack(fill="x", padx=10, pady=(10, 0), side="bottom")
        self.power.bind("<Button-1>", lambda e: self.toggle())
        self.status = tk.Label(root, text="", bg=BG, fg=DIM,
                               font=("DejaVu Sans", 11))
        self.status.pack(side="bottom", pady=3)

        self.paint()
        root.protocol("WM_DELETE_WINDOW", self.quit)
        root.after(300, lambda: root.geometry("480x776+0+24"))
        root.after(500, self.start)
        root.after(1600, self.tick)

    def key(self, parent, txt, cb):
        b = tk.Label(parent, text=txt, bg=KEY, fg=FG, pady=11,
                     font=("DejaVu Sans", 14, "bold"))
        b.pack(side="left", expand=True, fill="both", padx=3)
        b.bind("<Button-1>", lambda e: cb())
        return b

    # ── приёмник ──────────────────────────────────────────────────────
    def start(self):
        if not headset_in():
            self.status.config(text="вставьте наушники: без них нет антенны")
            self.root.after(2000, self.start)
            return
        try:
            if not bt_up():
                self.status.config(text="поднимаю чип, ~20 с…")
                self.root.update_idletasks()
                subprocess.run(["/usr/local/bin/btsetup"], capture_output=True,
                               timeout=120)
            with self.lock:
                self.s = self.fm["open_hci"]()
                self.fm["fm_on"](self.s)
            audio_ioctl(32, DEV_HEADSET)
            try:
                audio_ioctl(38)          # закрыть возможный старый сеанс
            except OSError:
                pass
            audio_ioctl(37)
            audio_ioctl(10, self.vol)
            fm_flag("fm_headset")
            self.on = True
            self.tune(self.khz)
            self.status.config(text="радио включено")
        except Exception as e:
            self.on = False
            self.status.config(text="не поднялось: %s" % str(e)[:44])
        self.paint()

    def stop(self):
        if self.on:
            try:
                audio_ioctl(38)
                with self.lock:
                    self.fm["fm_off"](self.s)
                fm_flag("disable")
            except Exception:
                pass
        self.on = False
        self.paint()

    def toggle(self):
        if self.on:
            self.stop()
            self.status.config(text="выключено")
        else:
            self.start()

    def tune(self, khz, quiet=False):
        khz = max(BAND[0], min(BAND[1], int(round(khz / 100.0)) * 100))
        self.khz = khz
        if self.on:
            # Перестройка в фоне и на СВЕЖЕМ соединении с приёмником:
            # из давно открытого сокета регистры принимают частоту, а
            # эфир не меняется (проверено на слух). В основном потоке
            # этого делать нельзя — 0.6 с, окно бы подвисало.
            threading.Thread(target=self.tune_hw, args=(khz,),
                             daemon=True).start()
        try:
            open("/run/fm", "w").write(str(khz))
        except OSError:
            pass
        if not quiet:
            self.paint()

    def tune_hw(self, khz):
        with self.lock:
            try:
                s2 = self.fm["open_hci"]()
                try:
                    self.fm["tune"](s2, khz)
                finally:
                    s2.close()
            except Exception as e:
                self.root.after(0, self.status.config,
                                {"text": "настройка: %s" % str(e)[:40]})

    def hop(self, d):
        """По найденным станциям; пока их нет — шагом 1 МГц."""
        if not self.stations:
            self.tune(self.khz + d * 1000)
            return
        st = sorted(self.stations)
        later = [k for k in st if k > self.khz + 50]
        earlier = [k for k in st if k < self.khz - 50]
        if d > 0:
            self.tune(later[0] if later else st[0])
        else:
            self.tune(earlier[-1] if earlier else st[-1])

    def volume(self, d):
        self.vol = max(0, min(100, self.vol + d))
        try:
            audio_ioctl(10, self.vol)
        except OSError:
            pass
        self.status.config(text="громкость %d%%" % self.vol)

    # ── обзор диапазона на слух ────────────────────────────────────
    # Автоматический поиск невозможен: этот чип не отдаёт ни уровня
    # сигнала, ни пилота стерео, ни RDS, а его собственный поиск всегда
    # рапортует «станции нет» (проверено). Поэтому — как SCAN в машине:
    # приёмник сам идёт по диапазону, слушает человек.
    DWELL = 2200                       # мс на частоту

    def scan_start(self):
        if not self.on:
            return
        if self.scanning:
            self.scan_stop(save=True)
            return
        self.scanning = True
        self.scan_btn.config(bg=RED, text="СТОП — это станция")
        self.status.config(text="обзор: слушайте, нажмите СТОП на станции")
        self.scan_step()

    def scan_step(self):
        if not self.scanning:
            return
        nxt = self.khz + 100
        if nxt > BAND[1]:
            nxt = BAND[0]
        self.tune(nxt)
        self._scan_job = self.root.after(self.DWELL, self.scan_step)

    def scan_stop(self, save=False):
        self.scanning = False
        if getattr(self, "_scan_job", None):
            self.root.after_cancel(self._scan_job)
            self._scan_job = None
        self.scan_btn.config(bg=KEY, text="Обзор диапазона")
        if save:
            self.remember()
        else:
            self.paint()

    # ── ручной ввод частоты ───────────────────────────────────────────
    def keypad(self):
        w = tk.Toplevel(self.root)
        w.title("Частота")
        w.configure(bg=BG)
        w.geometry("300x392+90+180")
        buf = {"s": ""}
        lbl = tk.Label(w, text="---", bg=BG, fg=FG,
                       font=("DejaVu Sans", 30, "bold"))
        lbl.pack(pady=(14, 4))
        tk.Label(w, text="например 101.7", bg=BG, fg=DIM,
                 font=("DejaVu Sans", 10)).pack()

        def show():
            lbl.config(text=buf["s"] or "---")

        def add(ch):
            if len(buf["s"]) < 5:
                buf["s"] += ch
                show()

        def back():
            buf["s"] = buf["s"][:-1]
            show()

        def ok():
            try:
                khz = int(round(float(buf["s"]) * 1000))
            except ValueError:
                w.destroy()
                return
            if BAND[0] - 100 <= khz <= BAND[1] + 100:
                self.tune(khz)
                self.status.config(text="введено %.1f МГц" % (khz / 1000.0))
            else:
                self.status.config(text="вне диапазона 87.5-108.0")
            w.destroy()

        g = tk.Frame(w, bg=BG)
        g.pack(expand=True, fill="both", padx=8, pady=8)
        for r, rowk in enumerate((("1", "2", "3"), ("4", "5", "6"),
                                  ("7", "8", "9"), (".", "0", "<"))):
            for c, ch in enumerate(rowk):
                cb = back if ch == "<" else (lambda ch=ch: add(ch))
                b = tk.Label(g, text=ch, bg=KEY, fg=FG, pady=10,
                             font=("DejaVu Sans", 18, "bold"))
                b.grid(row=r, column=c, padx=3, pady=3, sticky="nsew")
                b.bind("<Button-1>", lambda e, cb=cb: cb())
            g.rowconfigure(r, weight=1)
        for c in range(3):
            g.columnconfigure(c, weight=1)
        bar = tk.Frame(w, bg=BG)
        bar.pack(fill="x", padx=8, pady=(0, 8))
        for txt, cb, col in (("Отмена", w.destroy, KEY),
                             ("Настроить", ok, ACC)):
            b = tk.Label(bar, text=txt, bg=col, fg=FG, pady=10,
                         font=("DejaVu Sans", 13, "bold"))
            b.pack(side="left", expand=True, fill="both", padx=3)
            b.bind("<Button-1>", lambda e, cb=cb: cb())

    # ── список станций ────────────────────────────────────────────
    PER_PAGE = 6

    def load_list(self, path, n):
        out = [0] * n
        try:
            for i, t in enumerate(open(path).read().split()[:n]):
                out[i] = int(t)
        except (OSError, ValueError):
            pass
        return out

    def save_list(self, path, vals):
        try:
            open(path, "w").write(" ".join(str(v) for v in vals))
        except OSError:
            pass

    def save_stations(self):
        self.stations = sorted(set(self.stations))
        self.save_list(STATIONS_FILE, self.stations)

    def pages(self):
        return max(1, (len(self.stations) + self.PER_PAGE - 1) //
                   self.PER_PAGE)

    def flip(self, d):
        self.page = (self.page + d) % self.pages()
        self.paint()

    def remember(self):
        if self.khz in self.stations:
            self.status.config(text="%.1f уже в списке"
                                    % (self.khz / 1000.0))
        else:
            self.stations.append(self.khz)
            self.save_stations()
            self.page = self.stations.index(self.khz) // self.PER_PAGE
            self.status.config(text="запомнено %.1f (всего %d)"
                                    % (self.khz / 1000.0, len(self.stations)))
        self.paint()

    def clear_all(self):
        """Первый тап предупреждает, второй подряд — чистит."""
        if getattr(self, "_clear_armed", False):
            self._clear_armed = False
            self.stations = []
            self.page = 0
            self.save_stations()
            self.save_list(PRESETS_FILE, [])
            self.status.config(text="список станций очищен")
        else:
            self._clear_armed = True
            self.status.config(text="нажмите «очистить» ещё раз для сброса")
            self.root.after(4000, self.disarm_clear)
        self.paint()

    def disarm_clear(self):
        if getattr(self, "_clear_armed", False):
            self._clear_armed = False
            self.status.config(text="сброс отменён")

    def slot_freq(self, i):
        idx = self.page * self.PER_PAGE + i
        return self.stations[idx] if idx < len(self.stations) else 0

    def press(self, i):
        self._hold = self.root.after(700, lambda: self.remove(i))

    def release(self, i):
        if getattr(self, "_hold", None):
            self.root.after_cancel(self._hold)
            self._hold = None
            f = self.slot_freq(i)
            if f:
                self.tune(f)
            else:
                self.remember()

    def remove(self, i):
        """Долгий тап — убрать станцию из списка."""
        self._hold = None
        f = self.slot_freq(i)
        if not f:
            return
        self.stations.remove(f)
        self.save_stations()
        if self.page >= self.pages():
            self.page = self.pages() - 1
        self.status.config(text="удалено %.1f (осталось %d)"
                                % (f / 1000.0, len(self.stations)))
        self.paint()

    # ── отрисовка ─────────────────────────────────────────────────────
    def tap_scale(self, e):
        f = BAND[0] + (BAND[1] - BAND[0]) * max(0, min(460, e.x)) / 460.0
        self.tune(f)

    def paint(self):
        self.freq_lbl.config(text="%.1f" % (self.khz / 1000.0),
                             fg=FG if self.on else DIM)
        c = self.scale
        c.delete("all")
        for m in range(88, 108):
            x = (m * 1000 - BAND[0]) * 460 / (BAND[1] - BAND[0])
            c.create_line(x, 34, x, 56 if m % 2 == 0 else 48, fill=DIM)
            if m % 4 == 0:
                c.create_text(x, 12, text=str(m), fill=DIM,
                              font=("DejaVu Sans", 10))
        for k in self.stations:          # найденные станции — точками
            x = (k - BAND[0]) * 460 / (BAND[1] - BAND[0])
            c.create_oval(x - 3, 24, x + 3, 30, fill=ACC, outline="")
        x = (self.khz - BAND[0]) * 460 / (BAND[1] - BAND[0])
        c.create_line(x, 0, x, 56, fill="#e0a030", width=3)
        for i, b in enumerate(self.pbtn):
            f = self.slot_freq(i)
            b.config(text="%.1f" % (f / 1000.0) if f else "+",
                     bg=ACC if f and f == self.khz else KEY,
                     fg=FG if f else DIM)
        self.hint.config(text="%d станций · %d/%d · долгий тап удаляет"
                              % (len(self.stations), self.page + 1,
                                 self.pages()))
        self.power.config(text="Выключить" if self.on else "Включить",
                          bg=RED if self.on else ACC)

    def tick(self):
        # Регистры больше НЕ опрашиваем: уровень и стерео этот чип не
        # отдаёт (всегда 0x90 / нет пилота), а лишние обращения к нему
        # во время работы подозреваются в срыве перестройки.
        self.info.config(text="наушники работают антенной"
                              if self.on else "радио выключено")
        self.root.after(3000, self.tick)

    def quit(self):
        self.scan_stop()
        self.stop()
        self.root.destroy()


if __name__ == "__main__":
    _l = open("/tmp/.radio.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="radio")
    Radio(root)
    root.mainloop()
