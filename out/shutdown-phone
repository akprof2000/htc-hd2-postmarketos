#!/bin/sh
# «Выключение» HTC HD2 — на самом деле глубокий сон.
#
# Снять питание это ядро не умеет. ПРОВЕРЕНО 05.09 на живом телефоне:
#   poweroff       — init останавливает службы и виснет, ping жив;
#   SysRq «o»      — в ядре 3.0 зовёт тот же userspace-путь, то же;
#   poweroff -f    — вешает само ядро в остановке драйверов: экран
#                    замирает, USB жив, питание не снято.
# Зато сон работает: пишем «mem» в /sys/power/state, ядро гасит экран
# (early suspend) и засыпает, как только отпустят wakelock-и.
# Просыпается кнопкой питания; keysd при пробуждении пишет «on», иначе
# ядро, держа просьбу «mem», заснёт снова.
#
# ГЛУБОКИЙ СОН ЗАПРЕЩЁН. ПРОВЕРЕНО 05.09 владельцем: без кабеля
# телефон засыпает по-настоящему и уже не просыпается — виснет,
# нужна батарея. На кабеле до глубокого сна не доходило (держал
# vbus_present), потому и работало. Поэтому держим свой wakelock:
# с ним ядро останавливается на сне экрана и просыпается кнопкой.

/usr/local/bin/beep 2>/dev/null &
sync
echo 0 > /sys/class/leds/lcd-backlight/brightness
echo 0 > /sys/class/leds/button-backlight/brightness 2>/dev/null
echo nosuspend > /sys/power/wake_lock 2>/dev/null
echo mem > /sys/power/state
