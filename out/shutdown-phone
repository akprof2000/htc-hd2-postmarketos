#!/bin/sh
# Выключение HTC HD2.
#
# ПРОВЕРЕНО 05.09: штатный poweroff здесь виснет — busybox передаёт
# дело init, тот останавливает службы и застревает, не дойдя до снятия
# питания (телефон продолжает отвечать на ping). SysRq «o» не спасает:
# в ядре 3.0 он тоже зовёт userspace-овский poweroff. А вот прямой
# вызов ядра — poweroff -f, то есть reboot(RB_POWER_OFF) без init, —
# гасит телефон: ping умолкает сразу.
#
# Поэтому здесь: останавливаем СВОИ службы (они держат модем, звук и
# экран), сбрасываем буферы на диск и зовём ядро напрямую.

/usr/local/bin/beep 2>/dev/null &
for s in phoned keysd statusbar home shade rukbd rockbox; do
    pkill -x "$s" 2>/dev/null
done
sleep 1
sync
sleep 1
sync
poweroff -f
