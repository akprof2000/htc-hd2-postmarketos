#!/usr/bin/env python3
"""Галерея HTC HD2: листание фото тапами по краям экрана.

Ищет картинки в /root/Pictures и на карте (/mnt/fat). Тап слева/справа —
предыдущее/следующее, тап в центре — панель с именем файла.
"""
import fcntl
import os
import tkinter as tk
from PIL import Image, ImageTk

DIRS = ["/root/Pictures", "/mnt/fat", "/mnt/fat/DCIM", "/mnt/fat/Pictures"]
EXT = (".jpg", ".jpeg", ".png", ".gif", ".bmp")
BG = "#000000"


def scan():
    out = []
    for d in DIRS:
        try:
            for name in sorted(os.listdir(d)):
                if name.lower().endswith(EXT):
                    out.append(os.path.join(d, name))
        except OSError:
            pass
    return out


class Gallery:
    def __init__(self, root):
        self.root = root
        self.files = scan()
        self.i = 0
        self.photo = None
        root.title("Галерея")
        root.configure(bg=BG)
        root.geometry("480x740+0+0")

        self.cv = tk.Canvas(root, bg=BG, highlightthickness=0)
        self.cv.pack(expand=True, fill="both")
        self.cv.bind("<ButtonRelease-1>", self.tap)
        self.info = tk.Label(root, text="", font=("DejaVu Sans", 11),
                             bg=BG, fg="#9aa4b0")
        root.after(300, lambda: root.geometry("480x740+0+0"))
        root.after(100, self.show)

    def show(self):
        self.cv.delete("all")
        if not self.files:
            self.cv.create_text(240, 350, fill="#9aa4b0",
                                font=("DejaVu Sans", 13), justify="center",
                                text="нет фото\n\nзакиньте картинки в\n"
                                     "/root/Pictures или на карту")
            return
        path = self.files[self.i]
        try:
            im = Image.open(path)
            im.thumbnail((480, 700))
            self.photo = ImageTk.PhotoImage(im)
            self.cv.create_image(240, 360, image=self.photo)
        except OSError as e:
            self.cv.create_text(240, 350, fill="#ef5350",
                                text="не открылось:\n%s" % e,
                                font=("DejaVu Sans", 12))
        self.cv.create_text(240, 720, fill="#9aa4b0",
                            font=("DejaVu Sans", 11),
                            text="%d / %d · %s" % (
                                self.i + 1, len(self.files),
                                os.path.basename(path)[:40]))

    def tap(self, e):
        if not self.files:
            return
        if e.x < 160:
            self.i = (self.i - 1) % len(self.files)
        elif e.x > 320:
            self.i = (self.i + 1) % len(self.files)
        else:
            self.files = scan() or self.files   # центр — пересканировать
            self.i %= len(self.files)
        self.show()


if __name__ == "__main__":
    _l = open("/tmp/.gallery.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="gallery")
    Gallery(root)
    root.mainloop()
