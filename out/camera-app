#!/usr/bin/env python3
"""Камера HTC HD2: снимок → проявка → показ → /root/Pictures.

Захват — camsnap (наш RAW-стек s5k3e2fx+VFE8x), проявка — numpy:
дебайер GRBG, баланс белого «серый мир», гамма.
"""
import fcntl
import os
import subprocess
import threading
import time
import tkinter as tk

BG, FG, DIM = "#101828", "#e8eef5", "#7c8794"
OUT = "/root/Pictures"


def develop(rawfile, outfile):
    import numpy as np
    from PIL import Image
    W, H = 1296, 972
    d = np.fromfile(rawfile, dtype=np.uint8)
    g = d[:W * H].reshape(H, W).astype(np.float32)
    G1 = g[0::2, 0::2]; R = g[0::2, 1::2]
    B = g[1::2, 0::2]; G2 = g[1::2, 1::2]
    G = (G1 + G2) / 2
    # серый мир: выровнять средние каналов
    m = (R.mean() + G.mean() + B.mean()) / 3
    rgb = np.dstack([R * (m / max(R.mean(), 1)), G,
                     B * (m / max(B.mean(), 1))])
    rgb = np.clip(rgb / max(rgb.max(), 1), 0, 1) ** (1 / 2.2) * 255
    img = Image.fromarray(rgb.astype("uint8"))
    img.save(outfile, quality=92)
    return img


class Camera:
    def __init__(self, root):
        self.root = root
        root.title("Камера")
        root.configure(bg=BG)
        root.geometry("480x740+0+0")
        os.makedirs(OUT, exist_ok=True)

        self.view = tk.Label(root, text="нажмите «Снимок»",
                             font=("DejaVu Sans", 14), bg="#000000", fg=DIM)
        self.view.pack(expand=True, fill="both", padx=8, pady=8)

        self.btn = tk.Button(root, text="📷  Снимок",
                             font=("DejaVu Sans", 17, "bold"), bg="#1f7a33",
                             fg="white", relief="flat", bd=0, height=3,
                             command=self.shoot)
        self.btn.pack(fill="x", padx=16, pady=(0, 14))
        root.after(300, lambda: root.geometry("480x740+0+0"))
        self.photo = None

    def shoot(self):
        self.btn.config(text="снимаю… ~10 с", bg="#8a5a2e", state="disabled")
        threading.Thread(target=self.work, daemon=True).start()

    def work(self):
        try:
            r = subprocess.run(["/usr/local/bin/camsnap"],
                               capture_output=True, text=True, timeout=60)
            if "сохранены" not in r.stdout:
                raise RuntimeError(r.stdout.strip()[-80:] or "нет данных")
            name = os.path.join(OUT, time.strftime("photo-%Y%m%d-%H%M%S.jpg"))
            img = develop("/tmp/raw1.bin", name)
            img.thumbnail((464, 620))
            from PIL import ImageTk
            self.photo = ImageTk.PhotoImage(img)
            self.root.after(0, lambda: (
                self.view.config(image=self.photo, text=""),
                self.btn.config(text="📷  Снимок (сохранено)",
                                bg="#1f7a33", state="normal")))
        except Exception as e:
            self.root.after(0, lambda: self.btn.config(
                text="ошибка: %s" % str(e)[:40], bg="#a4262c",
                state="normal"))


if __name__ == "__main__":
    _l = open("/tmp/.camera.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="camera")
    Camera(root)
    root.mainloop()
