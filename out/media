#!/usr/bin/env python3
"""Медиаплеер HTC HD2.

Ищет музыку в /root/Music и на карте (/mnt/fat). Декодирует ffmpeg-ом,
играет через pcmplay (легаси-звук MSM). Всё под палец.
"""
import fcntl
import os
import signal
import subprocess
import tkinter as tk

DIRS = ["/root/Music", "/mnt/fat", "/mnt/fat/Music"]
EXT = (".mp3", ".wav", ".ogg", ".flac", ".m4a", ".aac", ".wma")
BG, FG, DIM, KEY = "#101828", "#e8eef5", "#7c8794", "#1c2a40"
ACCENT = "#1f7a33"


def scan():
    out = []
    for d in DIRS:
        try:
            for name in sorted(os.listdir(d)):
                if name.lower().endswith(EXT):
                    out.append(os.path.join(d, name))
        except OSError:
            pass
    return out


class Player:
    def __init__(self, root):
        self.root = root
        self.proc = None
        self.files = scan()
        self.headset = False

        root.title("Медиа")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")

        self.now = tk.Label(root, text="—", font=("DejaVu Sans", 13, "bold"),
                            bg=BG, fg=FG, wraplength=440)
        self.now.pack(fill="x", pady=(10, 4))

        self.lst = tk.Listbox(root, font=("DejaVu Sans", 13), bg=KEY, fg=FG,
                              selectbackground="#2a3a4a", relief="flat",
                              bd=0, activestyle="none")
        self.lst.pack(expand=True, fill="both", padx=10)
        for f in self.files:
            self.lst.insert("end", " " + os.path.basename(f))
        if not self.files:
            self.lst.insert("end", " нет музыки — закиньте файлы")
            self.lst.insert("end", " в /root/Music или на карту")
        self.lst.bind("<Double-Button-1>", lambda e: self.play())

        bar = tk.Frame(root, bg=BG)
        bar.pack(fill="x", padx=10, pady=8)
        self.btn = tk.Button(bar, text="▶ Играть",
                             font=("DejaVu Sans", 15, "bold"), bg=ACCENT,
                             fg="white", relief="flat", bd=0, height=2,
                             command=self.toggle)
        self.btn.pack(side="left", expand=True, fill="both", padx=(0, 4))
        self.out = tk.Button(bar, text="Динамик", font=("DejaVu Sans", 13),
                             bg=KEY, fg=FG, relief="flat", bd=0, height=2,
                             command=self.route)
        self.out.pack(side="left", expand=True, fill="both", padx=(4, 0))

        root.after(300, lambda: root.geometry("480x776+0+24"))
        self.watch()

    def sel(self):
        s = self.lst.curselection()
        return self.files[s[0]] if s and s[0] < len(self.files) else None

    def play(self):
        f = self.sel()
        if not f:
            return
        self.stop()
        cmd = ("ffmpeg -v quiet -i \"%s\" -f s16le -ac 2 -ar 44100 - | "
               "/usr/local/bin/pcmplay %s") % (f, "h" if self.headset else "")
        self.proc = subprocess.Popen(cmd, shell=True, start_new_session=True)
        self.now.config(text="▶ " + os.path.basename(f))
        self.btn.config(text="■ Стоп", bg="#a4262c")

    def stop(self):
        if self.proc and self.proc.poll() is None:
            os.killpg(self.proc.pid, signal.SIGKILL)
        self.proc = None
        self.now.config(text="—")
        self.btn.config(text="▶ Играть", bg=ACCENT)

    def toggle(self):
        if self.proc and self.proc.poll() is None:
            self.stop()
        else:
            if not self.lst.curselection() and self.files:
                self.lst.selection_set(0)
            self.play()

    def route(self):
        self.headset = not self.headset
        self.out.config(text="Наушники" if self.headset else "Динамик")
        if self.proc and self.proc.poll() is None:
            self.play()                  # перезапустить на новом выходе

    def watch(self):
        # трек закончился сам — вернуть кнопку
        if self.proc and self.proc.poll() is not None:
            self.stop()
        self.root.after(1000, self.watch)


if __name__ == "__main__":
    _l = open("/tmp/.media.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="media")
    Player(root)
    root.mainloop()
