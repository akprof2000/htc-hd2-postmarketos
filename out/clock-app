#!/usr/bin/env python3
"""Часы HTC HD2: будильник + таймер + секундомер.

Будильник живёт в crontab (busybox crond) — сработает, даже если
приложение закрыто: /usr/local/bin/alarm-fire играет мелодию и вибрирует.
"""
import fcntl
import subprocess
import time
import tkinter as tk

BG, FG, DIM, KEY, ACC = "#101828", "#e8eef5", "#7c8794", "#1c2a40", "#1f7a33"
RED = "#a4262c"
TAG = "# icemobile-alarm"


def cron_get():
    try:
        out = subprocess.run(["crontab", "-l"], capture_output=True,
                             text=True).stdout
    except OSError:
        return None
    for ln in out.splitlines():
        if TAG in ln:
            p = ln.split()
            return "%02d:%02d" % (int(p[1]), int(p[0]))
    return None


def cron_set(hhmm):
    try:
        out = subprocess.run(["crontab", "-l"], capture_output=True,
                             text=True).stdout
    except OSError:
        out = ""
    lines = [l for l in out.splitlines() if TAG not in l]
    if hhmm:
        h, m = hhmm.split(":")
        lines.append("%d %d * * * /usr/local/bin/alarm-fire %s"
                     % (int(m), int(h), TAG))
    p = subprocess.Popen(["crontab", "-"], stdin=subprocess.PIPE, text=True)
    p.communicate("\n".join(lines) + "\n")


def buzz(ms=400):
    try:
        with open("/sys/class/timed_output/vibrator/enable", "w") as f:
            f.write(str(ms))
    except OSError:
        pass


def ring():
    subprocess.Popen(["/usr/local/bin/ringtone"], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    buzz(600)


class Clock:
    def __init__(self, root):
        self.root = root
        root.title("Часы")
        root.configure(bg=BG)
        root.geometry("480x740+0+0")

        # ── вкладки ───────────────────────────────────────────────────
        tabs = tk.Frame(root, bg=BG)
        tabs.pack(fill="x", pady=(8, 0))
        self.tab_btns = {}
        for name in ("Будильник", "Таймер", "Секундомер"):
            b = tk.Button(tabs, text=name, font=("DejaVu Sans", 13, "bold"),
                          bg=KEY, fg=FG, relief="flat", bd=0, height=2,
                          command=lambda n=name: self.show(n))
            b.pack(side="left", expand=True, fill="both", padx=2)
            self.tab_btns[name] = b
        self.body = tk.Frame(root, bg=BG)
        self.body.pack(expand=True, fill="both")

        # будильник
        self.al_h, self.al_m = 7, 0
        saved = cron_get()
        if saved:
            self.al_h, self.al_m = (int(x) for x in saved.split(":"))
        self.al_on = saved is not None
        # таймер
        self.t_left, self.t_run = 300, False
        # секундомер
        self.sw_acc, self.sw_start = 0.0, None

        self.show("Будильник")
        self.tick()

    def clear(self):
        for w in self.body.winfo_children():
            w.destroy()

    def show(self, tab):
        self.tab = tab
        for n, b in self.tab_btns.items():
            b.config(bg=ACC if n == tab else KEY)
        self.clear()
        getattr(self, "ui_" + {"Будильник": "alarm", "Таймер": "timer",
                               "Секундомер": "sw"}[tab])()

    # ── будильник ─────────────────────────────────────────────────────
    def ui_alarm(self):
        self.al_lbl = tk.Label(self.body, text="",
                               font=("DejaVu Sans", 64, "bold"),
                               bg=BG, fg=FG)
        self.al_lbl.pack(pady=(30, 6))
        self.al_state = tk.Label(self.body, text="",
                                 font=("DejaVu Sans", 14), bg=BG, fg=DIM)
        self.al_state.pack()
        grid = tk.Frame(self.body, bg=BG)
        grid.pack(pady=16)
        for col, (txt, dh, dm) in enumerate(
                [("−1 ч", -1, 0), ("−10 м", 0, -10), ("+10 м", 0, 10),
                 ("+1 ч", 1, 0)]):
            tk.Button(grid, text=txt, font=("DejaVu Sans", 15, "bold"),
                      bg=KEY, fg=FG, relief="flat", bd=0, width=6, height=2,
                      command=lambda a=dh, b=dm: self.al_adj(a, b)
                      ).grid(row=0, column=col, padx=4)
        self.al_btn = tk.Button(self.body, text="",
                                font=("DejaVu Sans", 17, "bold"),
                                fg="white", relief="flat", bd=0, height=3,
                                command=self.al_toggle)
        self.al_btn.pack(fill="x", padx=24, pady=18)
        self.al_draw()

    def al_adj(self, dh, dm):
        m = (self.al_h * 60 + self.al_m + dh * 60 + dm) % (24 * 60)
        self.al_h, self.al_m = m // 60, m % 60
        if self.al_on:
            cron_set("%02d:%02d" % (self.al_h, self.al_m))
        self.al_draw()

    def al_toggle(self):
        self.al_on = not self.al_on
        cron_set("%02d:%02d" % (self.al_h, self.al_m) if self.al_on else None)
        self.al_draw()

    def al_draw(self):
        self.al_lbl.config(text="%02d:%02d" % (self.al_h, self.al_m))
        self.al_state.config(
            text="будильник включён" if self.al_on else "выключен",
            fg="#66bb6a" if self.al_on else DIM)
        self.al_btn.config(text="Выключить" if self.al_on else "Включить",
                           bg=RED if self.al_on else ACC)

    # ── таймер ────────────────────────────────────────────────────────
    def ui_timer(self):
        self.t_lbl = tk.Label(self.body, text="",
                              font=("DejaVu Sans", 64, "bold"), bg=BG, fg=FG)
        self.t_lbl.pack(pady=(30, 10))
        grid = tk.Frame(self.body, bg=BG)
        grid.pack(pady=8)
        for col, (txt, sec) in enumerate([("+1 м", 60), ("+5 м", 300),
                                          ("+10 м", 600), ("Сброс", 0)]):
            tk.Button(grid, text=txt, font=("DejaVu Sans", 15, "bold"),
                      bg=KEY, fg=FG, relief="flat", bd=0, width=6, height=2,
                      command=lambda s=sec: self.t_add(s)
                      ).grid(row=0, column=col, padx=4)
        self.t_btn = tk.Button(self.body, text="",
                               font=("DejaVu Sans", 17, "bold"), fg="white",
                               relief="flat", bd=0, height=3,
                               command=self.t_toggle)
        self.t_btn.pack(fill="x", padx=24, pady=18)
        self.t_draw()

    def t_add(self, sec):
        if sec == 0:
            self.t_left, self.t_run = 0, False
        else:
            self.t_left += sec
        self.t_draw()

    def t_toggle(self):
        if self.t_left > 0:
            self.t_run = not self.t_run
        self.t_draw()

    def t_draw(self):
        if not hasattr(self, "t_lbl") or not self.t_lbl.winfo_exists():
            return
        self.t_lbl.config(text="%02d:%02d" % (self.t_left // 60,
                                              self.t_left % 60))
        self.t_btn.config(text="Пауза" if self.t_run else "Старт",
                          bg=RED if self.t_run else ACC)

    # ── секундомер ────────────────────────────────────────────────────
    def ui_sw(self):
        self.sw_lbl = tk.Label(self.body, text="",
                               font=("DejaVu Sans", 56, "bold"),
                               bg=BG, fg=FG)
        self.sw_lbl.pack(pady=(40, 16))
        bar = tk.Frame(self.body, bg=BG)
        bar.pack(fill="x", padx=24)
        self.sw_btn = tk.Button(bar, text="", font=("DejaVu Sans", 17,
                                                    "bold"),
                                fg="white", relief="flat", bd=0, height=3,
                                command=self.sw_toggle)
        self.sw_btn.pack(side="left", expand=True, fill="both", padx=(0, 4))
        tk.Button(bar, text="Сброс", font=("DejaVu Sans", 17, "bold"),
                  bg=KEY, fg=FG, relief="flat", bd=0, height=3,
                  command=self.sw_reset).pack(side="left", expand=True,
                                              fill="both", padx=(4, 0))
        self.sw_draw()

    def sw_toggle(self):
        if self.sw_start is None:
            self.sw_start = time.monotonic()
        else:
            self.sw_acc += time.monotonic() - self.sw_start
            self.sw_start = None
        self.sw_draw()

    def sw_reset(self):
        self.sw_acc, self.sw_start = 0.0, None
        self.sw_draw()

    def sw_val(self):
        v = self.sw_acc
        if self.sw_start is not None:
            v += time.monotonic() - self.sw_start
        return v

    def sw_draw(self):
        if not hasattr(self, "sw_lbl") or not self.sw_lbl.winfo_exists():
            return
        v = self.sw_val()
        self.sw_lbl.config(text="%02d:%02d.%d" % (v // 60, v % 60,
                                                  (v * 10) % 10))
        self.sw_btn.config(text="Стоп" if self.sw_start else "Старт",
                           bg=RED if self.sw_start else ACC)

    # ── общий пульс ───────────────────────────────────────────────────
    def tick(self):
        if self.t_run:
            self.t_left -= 1
            if self.t_left <= 0:
                self.t_left, self.t_run = 0, False
                ring()
            if self.tab == "Таймер":
                self.t_draw()
        if self.tab == "Секундомер" and self.sw_start is not None:
            self.sw_draw()
        self.root.after(1000 if self.tab != "Секундомер" else 100,
                        self.tick)


if __name__ == "__main__":
    _l = open("/tmp/.clockapp.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="clockapp")
    Clock(root)
    root.mainloop()
