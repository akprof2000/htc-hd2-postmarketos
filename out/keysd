#!/usr/bin/env python3
"""Аппаратные кнопки HTC HD2 (htcleo-keypad, /dev/input/event4).

Раскладка как у телефона:
    зелёная (KEY_SEND 231)  — входящий: ответить; иначе открыть звонилку
    красная (KEY_END 107)   — вызов: сбросить; иначе экран вкл/выкл,
                              долгое нажатие (>=2.5 с) — выключение питания
    домик (KEY_HOME 102) и Windows (KEY_MENU 139) — домашний экран
    назад (KEY_BACK 158)    — закрыть активное окно (кроме «Домой»)
"""
import os
import struct
import subprocess
import threading
import time

DEV = "/dev/input/event4"
BL = "/sys/class/leds/lcd-backlight/brightness"
RUN = "/run/phone"

KEY_SEND, KEY_HOME, KEY_MENU, KEY_END, KEY_BACK = 231, 102, 139, 107, 158
KEY_VOLDOWN, KEY_VOLUP = 114, 115
LONG = 2.5
BTN_BL = "/sys/class/leds/button-backlight/brightness"
VOLFILE = os.path.join(RUN, "vol")


def state():
    try:
        with open(os.path.join(RUN, "state")) as f:
            return f.read().strip()
    except OSError:
        return "idle"


def at(cmd):
    try:
        with open(os.path.join(RUN, "cmd"), "w") as f:
            f.write(cmd + "\n")
    except OSError:
        pass


def sh(cmd):
    subprocess.Popen(cmd, shell=True, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def screen_toggle():
    try:
        cur = int(open(BL).read())
    except (OSError, ValueError):
        cur = 0
    with open(BL, "w") as f:
        f.write("0" if cur > 0 else "180")


def raise_win(title):
    sh("DISPLAY=:0 wmctrl -a '%s'" % title)


_bl_timer = [None]


def flash_buttons():
    """Подсветка аппаратных кнопок: загорается при нажатии, гаснет через 3 с."""
    try:
        with open(BTN_BL, "w") as f:
            f.write("255")
    except OSError:
        return
    if _bl_timer[0]:
        _bl_timer[0].cancel()
    def off():
        try:
            with open(BTN_BL, "w") as f:
                f.write("0")
        except OSError:
            pass
    _bl_timer[0] = threading.Timer(3.0, off)
    _bl_timer[0].daemon = True
    _bl_timer[0].start()


def fm_active():
    """Радио включено? Флаг ставит radio-app при включении приёмника."""
    try:
        with open("/sys/class/htc_accessory/fm/flag") as f:
            return f.read().strip() == "fm_headset"
    except OSError:
        return False


def set_hw_volume(vol):
    """AUDIO_SET_VOLUME без переключения устройства."""
    try:
        fd = os.open("/dev/msm_audio_ctl", os.O_RDWR)
        try:
            code = (1 << 30) | (4 << 16) | (ord("a") << 8) | 10
            fcntl.ioctl(fd, code, struct.pack("I", max(0, min(100, vol))))
        finally:
            os.close(fd)
    except OSError:
        pass


def volume_step(delta):
    """Качелька громкости: шаг 10%, OSD и блик на новой громкости."""
    try:
        cur = int(open(VOLFILE).read().strip())
    except (OSError, ValueError):
        cur = 70
    vol = max(0, min(100, cur + delta))
    try:
        with open(VOLFILE, "w") as f:
            f.write(str(vol))
    except OSError:
        pass
    sh("DISPLAY=:0 /usr/local/bin/volosd")
    if fm_active():
        # радио: блик в динамик переключил бы выход с наушников и порвал
        # аналоговую петлю FM — меняем только громкость тракта
        set_hw_volume(vol)
        return
    at("@vol %d" % vol)                  # громкость тракта (и в разговоре)
    if state() == "idle" and vol > 0:    # блик слышен как раз на новом уровне
        sh("/usr/local/bin/beep s %d" % vol)


# классы окон, где нужен ввод текста — там клавиатура показывается сама
TYPING = ("xfce4-terminal", "phone-sms", "sms", "notes",
          "dillo", "mailapp")


def kbd_watcher():
    """Автопоказ клавиатуры: есть окно ввода — показать, нет — спрятать."""
    env = dict(os.environ, DISPLAY=":0")
    last = None
    while True:
        time.sleep(1.0)
        try:
            cls = subprocess.run(
                ["xdotool", "getactivewindow", "getwindowclassname"],
                capture_output=True, text=True, env=env,
                timeout=5).stdout.strip().lower()
        except (OSError, subprocess.TimeoutExpired):
            continue
        # окна-служебки не меняют решение (иначе клавиатура мигает)
        if any(x in cls for x in ("rukbd", "statusbar", "volosd")):
            continue
        want = any(t in cls for t in TYPING)
        if want == last:
            continue
        last = want
        on = subprocess.run(["pgrep", "-f", "bin/rukbd"],
                            stdout=subprocess.DEVNULL).returncode == 0
        if want and not on:
            subprocess.run(["/usr/local/bin/kbd"], env=env,
                           stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)
        elif not want and on:
            subprocess.run(["pkill", "-f", "bin/rukbd"], stdout=subprocess.DEVNULL)


def touch_sleep():
    """Автосон: 2 мин без касаний — подсветка гаснет; касание будит.
    Пока экран тёмный, тач захвачен (EVIOCGRAB) — пробуждающий тап
    не нажимает ничего в интерфейсе."""
    import fcntl
    import select as sel
    EVIOCGRAB = (1 << 30) | (4 << 16) | (ord('E') << 8) | 0x90
    try:
        f = open("/dev/input/event0", "rb")
    except OSError:
        return
    last = time.monotonic()
    dark = False
    while True:
        r, _, _ = sel.select([f], [], [], 5.0)
        if r:
            try:
                f.read(16)
            except OSError:
                pass
            last = time.monotonic()
            if dark:                     # проснуться
                try:
                    with open(BL, "w") as b:
                        b.write("180")
                except OSError:
                    pass
                try:
                    fcntl.ioctl(f, EVIOCGRAB, 0)
                except OSError:
                    pass
                dark = False
        else:
            try:
                lit = int(open(BL).read()) > 0
            except (OSError, ValueError):
                lit = False
            if lit and not dark and \
                    time.monotonic() - last > 120 and state() == "idle":
                try:
                    with open(BL, "w") as b:
                        b.write("0")
                    fcntl.ioctl(f, EVIOCGRAB, 1)
                    dark = True
                except OSError:
                    pass
            if not lit and not dark:     # погасили красной кнопкой
                dark = True
                try:
                    fcntl.ioctl(f, EVIOCGRAB, 1)
                except OSError:
                    pass


def main():
    threading.Thread(target=kbd_watcher, daemon=True).start()
    threading.Thread(target=touch_sleep, daemon=True).start()
    f = open(DEV, "rb")
    # эксклюзивный захват: иначе X тоже видит кнопки, и, например, меню
    # от кнопки Windows открывается нами и тут же закрывается X-ом
    import fcntl
    EVIOCGRAB = (1 << 30) | (4 << 16) | (ord('E') << 8) | 0x90
    try:
        fcntl.ioctl(f, EVIOCGRAB, 1)
    except OSError:
        pass
    pressed = {}
    hung_up = [False]
    while True:
        t1, t2, typ, code, val = struct.unpack("IIHHi", f.read(16))
        if typ != 1:
            continue

        if val == 1:                                  # нажатие
            flash_buttons()
            pressed[code] = time.monotonic()
            st = state()
            if code == KEY_VOLUP:
                volume_step(+10)
            elif code == KEY_VOLDOWN:
                volume_step(-10)
            elif code == KEY_SEND:
                if st == "ringing":
                    at("ATA")
                else:
                    sh("DISPLAY=:0 wmctrl -a 'Телефон' || "
                       "DISPLAY=:0 /usr/local/bin/phone-gui")
            elif code == KEY_END and st != "idle":
                at("ATH")
                hung_up[0] = True
            elif code == KEY_HOME:
                raise_win("Домой")
            elif code == KEY_MENU:
                # своё меню: IceWM-ное закрывалось релизом Esc от xdotool
                sh("DISPLAY=:0 /usr/local/bin/sysmenu")
            elif code == KEY_BACK:
                # закрыть активное окно, но домашний экран не трогать
                sh("DISPLAY=:0 sh -c '"
                   "n=$(xdotool getactivewindow getwindowname 2>/dev/null); "
                   "[ \"$n\" != \"Домой\" ] && wmctrl -c :ACTIVE:'")

        elif val == 0 and code in pressed:            # отпускание
            dur = time.monotonic() - pressed.pop(code)
            if code == KEY_END:
                if hung_up[0]:        # этим нажатием сбросили вызов —
                    hung_up[0] = False  # экран не трогаем
                elif dur >= LONG:
                    sh("DISPLAY=:0 /usr/local/bin/powermenu")
                else:
                    screen_toggle()


if __name__ == "__main__":
    # единственный экземпляр: два сторожа наперегонки мигают клавиатурой
    import fcntl as _f
    _lock = open("/tmp/.keysd.lock", "w")
    try:
        _f.flock(_lock, _f.LOCK_EX | _f.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    main()
