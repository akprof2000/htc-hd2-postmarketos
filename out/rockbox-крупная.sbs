# Крупная строка состояния для HTC HD2.
#
# В стандартной строке значки — отдельные картинки по 16 пикселей, и от
# размера шрифта они не зависят: на экране 480x800 их не разглядеть.
# Поэтому здесь ничего не рисуется картинками — всё написано основным
# шрифтом (шрифт 1), а полоса поднята до 48 пикселей.

# Место под списки и всё остальное: экран за вычетом полосы сверху
%Vi(-,0,48,-,-,1)

# Сама полоса: слева заряд, посередине состояние, справа часы
%V(8,8,-,36,1)
%al%?bc<+>%bl%%%ac%?mp<стоп|играет|пауза|вперёд|назад|запись|пауза|радио|радио>%ar%?cc<%?St(time format)<%cH|%cI>:%cM|>
