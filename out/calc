#!/usr/bin/env python3
"""Калькулятор HTC HD2 — под палец."""
import fcntl
import tkinter as tk

BG, FG, KEY, OP, EQ = "#101828", "#e8eef5", "#1c2a40", "#33415c", "#1f7a33"


class Calc:
    def __init__(self, root):
        self.expr = ""
        root.title("Калькулятор")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")

        self.disp = tk.Label(root, text="0", font=("DejaVu Sans", 30, "bold"),
                             bg=BG, fg=FG, anchor="e", padx=14)
        self.disp.pack(fill="x", pady=(16, 8), ipady=10)

        grid = tk.Frame(root, bg=BG)
        grid.pack(expand=True, fill="both", padx=8, pady=(0, 8))
        keys = [("C", OP), ("(", OP), (")", OP), ("÷", OP),
                ("7", KEY), ("8", KEY), ("9", KEY), ("×", OP),
                ("4", KEY), ("5", KEY), ("6", KEY), ("−", OP),
                ("1", KEY), ("2", KEY), ("3", KEY), ("+", OP),
                ("⌫", OP), ("0", KEY), (".", KEY), ("=", EQ)]
        for i, (k, color) in enumerate(keys):
            b = tk.Button(grid, text=k, font=("DejaVu Sans", 20, "bold"),
                          bg=color, fg="white", relief="flat", bd=0,
                          command=lambda x=k: self.press(x))
            b.grid(row=i // 4, column=i % 4, sticky="nsew", padx=4, pady=4)
        for c in range(4):
            grid.columnconfigure(c, weight=1)
        for r in range(5):
            grid.rowconfigure(r, weight=1)
        root.after(300, lambda: root.geometry("480x776+0+24"))
        self.root = root

    def press(self, k):
        if k == "C":
            self.expr = ""
        elif k == "⌫":
            self.expr = self.expr[:-1]
        elif k == "=":
            try:
                e = (self.expr.replace("÷", "/").replace("×", "*")
                     .replace("−", "-"))
                if e and all(c in "0123456789.+-*/() " for c in e):
                    r = eval(e)  # выражение отфильтровано выше
                    self.expr = ("%g" % r)
            except (SyntaxError, ZeroDivisionError, ValueError):
                self.expr = ""
                self.disp.config(text="ошибка")
                return
        else:
            self.expr += k
        self.disp.config(text=self.expr or "0")


if __name__ == "__main__":
    _l = open("/tmp/.calc.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="calc")
    Calc(root)
    root.mainloop()
