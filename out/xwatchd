#!/bin/sh
# Сторож графики HTC HD2.
#
# ЗА ЧТО ПЕРЕПИСАН (04.09.2026): прежний сторож снимал кадр через xwd и
# перезапускал графику, если картинка тёмная. Оба решения оказались
# вредными:
#   * xwd на этом X сам подвешивает сервер — то есть сторож ломал ровно
#     то, что охранял;
#   * тёмный кадр — это НЕ поломка. Галерея без фото, камера в темноте,
#     переписка на чёрном фоне — всё это законно тёмное, и сторож раз за
#     разом убивал живую графику вместе с домашним экраном. В журнале
#     восемь таких перезапусков, последний — ровно в минуту, когда
#     пользователь увидел пропавший домашний экран.
#
# Теперь признак беды один: X НЕ ОТВЕЧАЕТ. Это проверяется дешёвым
# запросом xset -q с таймаутом, без единого снимка экрана. Кадр из
# /dev/fb0 читается только как вторая улика (и не трогает X вовсе).
# Перезапуск — лишь когда сервер молчит трижды подряд, то есть три
# минуты; одиночная заминка ничего не роняет.
BL=/sys/class/leds/lcd-backlight/brightness
LOG=/var/log/xwatchd.log
dead=0

while :; do
    sleep 60
    # экран погашен — спящему телефону сторож не нужен
    [ "$(cat $BL 2>/dev/null)" = "0" ] && { dead=0; continue; }

    if DISPLAY=:0 timeout 10 xset -q >/dev/null 2>&1; then
        dead=0                      # сервер отвечает — всё в порядке
        continue
    fi

    dead=$((dead + 1))
    echo "$(date +%H:%M:%S) X не отвечает ($dead из 3)" >> $LOG
    if [ $dead -ge 3 ]; then
        echo "$(date +%H:%M:%S) три минуты молчания — перезапуск графики" \
            >> $LOG
        /usr/local/bin/x-restart >/dev/null 2>&1
        dead=0
    fi
done
