#!/bin/sh
# Сторож графики HTC HD2.
#
# ЧТО ОН ЛОВИТ: телефон остаётся с горящей подсветкой и чёрным экраном
# при живом X — сервер отвечает, окна на месте, но в кадровый буфер
# ничего не попадает. Само не проходит, лечится только перезапуском
# графики.
#
# ИСТОРИЯ ДВУХ ОШИБОК (04.09.2026), чтобы не наступить снова:
#   1. Прежний сторож снимал кадр через xwd и считал бедой тёмную
#      картинку. xwd на этом X сам подвешивает сервер, а тёмный кадр —
#      не поломка: галерея без фото даёт РОВНО ноль яркости. Итог —
#      восемь перезапусков живой графики, домашний экран пропадал прямо
#      под руками у человека.
#   2. Я убрал проверку картинки совсем и оставил только «отвечает ли
#      X». Ложные срабатывания ушли, но вместе с ними ушёл и настоящий
#      признак: при чёрном экране X отвечает прекрасно, и сторож молчал.
#
# КАК ПРАВИЛЬНО: спросить не «темно ли», а «доходит ли рисование до
# экрана». Это делает fbprobe — на 0,3 с показывает белый квадратик в
# углу и читает те же точки из /dev/fb0. Тёмное приложение проверку
# проходит, мёртвый тракт — нет.
BL=/sys/class/leds/lcd-backlight/brightness
LOG=/var/log/xwatchd.log
bad=0

while :; do
    sleep 30
    # экран погашен — спящему телефону сторож не нужен
    [ "$(cat $BL 2>/dev/null)" = "0" ] && { bad=0; continue; }

    if ! DISPLAY=:0 timeout 10 xset -q >/dev/null 2>&1; then
        bad=$((bad + 1))
        echo "$(date +%H:%M:%S) X не отвечает ($bad из 3, проверка раз в 30 с)" >> $LOG
    elif ! DISPLAY=:0 timeout 15 /usr/local/bin/fbprobe; then
        bad=$((bad + 1))
        echo "$(date +%H:%M:%S) рисование не доходит до экрана ($bad из 3, проверка раз в 30 с)" \
            >> $LOG
    else
        bad=0                       # всё в порядке
        continue
    fi

    if [ $bad -ge 3 ]; then
        echo "$(date +%H:%M:%S) полторы минуты подряд — перезапуск графики" >> $LOG
        /usr/local/bin/x-restart >/dev/null 2>&1
        bad=0
    fi
done
