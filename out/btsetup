#!/bin/sh
# Поднять Bluetooth на HTC HD2: питание, прошивка (только 115200!),
# имя/класс/видимость, запрет сна чипа (LPM-драйвера в ядре нет).
pkill hciattach 2>/dev/null
hciconfig hci0 down 2>/dev/null
sleep 1
echo 0 > /sys/class/rfkill/rfkill0/state 2>/dev/null; sleep 2
echo 1 > /sys/class/rfkill/rfkill0/state 2>/dev/null; sleep 2
hciattach -s 115200 /dev/ttyHS0 bcm43xx 115200 flow nosleep     7c:61:93:45:4b:89 >/tmp/btattach.log 2>&1 &
i=0
while [ $i -lt 25 ]; do
    grep -q 'setup complete' /tmp/btattach.log 2>/dev/null && break
    i=$((i+1)); sleep 1
done
# Заплатку прошивки грузим САМИ. hciattach её не находит ни в одном
# каталоге («Patch not found for BCM4329B1, continue anyway»), и чип
# остаётся на базовом ПЗУ: команды выполняет, а радио молчит — телефон
# никого не видит и сам невидим. Проверено 04.09: после заливки ревизия
# прошивки меняется с 0x0 на 0x2f0 и поиск сразу находит устройства.
hciconfig hci0 up 2>/dev/null
sleep 1
/usr/local/bin/btpatch >/tmp/btpatch.log 2>&1
# заливка сбрасывает адрес в мусорный — возвращаем свой (0xFC01)
hcitool -i hci0 cmd 0x3f 0x01 0x89 0x4b 0x45 0x93 0x61 0x7c >/dev/null 2>&1
sleep 1
hciconfig hci0 down 2>/dev/null
hciconfig hci0 up 2>/dev/null
sleep 1
hcitool -i hci0 cmd 0x3f 0x27 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00     0x00 0x00 0x00 0x00 >/dev/null 2>&1
hciconfig hci0 name 'HTC HD2'
hciconfig hci0 class 0x5a0204
hciconfig hci0 piscan

# Насколько охотно телефон отзывается на чужой поиск и вызов. По
# умолчанию он слушает 11 мс каждые 2,56 с — 0,4% времени, и снаружи
# его почти не поймать: ноутбук его так и не находил. Расширяем окно
# (интервал 1,28 с, окно 160 мс) и включаем чередующееся сканирование,
# после чего телефон находится сразу.
hcitool -i hci0 cmd 0x03 0x1e 0x00 0x08 0x00 0x01 >/dev/null 2>&1  # окно поиска
hcitool -i hci0 cmd 0x03 0x1c 0x00 0x08 0x00 0x01 >/dev/null 2>&1  # окно вызова
hcitool -i hci0 cmd 0x03 0x43 0x01 >/dev/null 2>&1                 # поиск вперемежку
hcitool -i hci0 cmd 0x03 0x47 0x01 >/dev/null 2>&1                 # вызов вперемежку

# Отвечать на входящее сопряжение некому, если агент не запущен
pgrep -x btagent >/dev/null 2>&1 ||     setsid /usr/local/bin/btagent 0000 </dev/null >/dev/null 2>&1 &

hciconfig hci0 | head -3
