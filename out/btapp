#!/usr/bin/env python3
"""Bluetooth для HTC HD2 — экран управления.

Включение/выключение, видимость, поиск устройств (свой сканер по сырому
HCI: hcitool на этом чипе не работает), попытка соединения.
Кнопки — Label с bind: tk.Button на этом X рисуется пустым.
"""
import fcntl
import os
import subprocess
import threading
import tkinter as tk

BG, FG, DIM, KEY, ACC = "#101828", "#e8eef5", "#7c8794", "#22314a", "#1f7a33"
RED = "#a4262c"


def sh(cmd, timeout=90):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True,
                              text=True, timeout=timeout).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def buzz():
    try:
        with open("/sys/class/timed_output/vibrator/enable", "w") as f:
            f.write("30")
    except OSError:
        pass


def bt_state():
    out = sh("hciconfig hci0 2>/dev/null", 10)
    if not out:
        return "off", "", ""
    up = "UP RUNNING" in out
    disc = "ISCAN" in out
    addr = ""
    for tok in out.split():
        if tok.count(":") == 5:
            addr = tok
            break
    return ("on" if up else "down"), addr, ("да" if disc else "нет")


class BtApp:
    def __init__(self, root):
        self.root = root
        self.busy = False
        root.title("Bluetooth")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")

        tk.Label(root, text="Bluetooth", font=("DejaVu Sans", 18, "bold"),
                 bg=BG, fg=FG).pack(pady=(10, 4))
        self.status = tk.Label(root, text="проверяю…",
                               font=("DejaVu Sans", 11), bg=BG, fg=DIM,
                               justify="left")
        self.status.pack(pady=(0, 6))

        row = tk.Frame(root, bg=BG)
        row.pack(fill="x", padx=10)
        self.b_power = self.tile(row, "Включить", self.toggle_power)
        self.b_vis = self.tile(row, "Видимость", self.toggle_vis)
        row2 = tk.Frame(root, bg=BG)
        row2.pack(fill="x", padx=10, pady=6)
        self.b_scan = self.tile(row2, "🔍  Найти устройства", self.scan)

        tk.Label(root, text="Найденные устройства",
                 font=("DejaVu Sans", 12, "bold"), bg=BG, fg=DIM,
                 anchor="w", padx=12).pack(fill="x", pady=(8, 2))
        self.list = tk.Frame(root, bg=BG)
        self.list.pack(expand=True, fill="both", padx=10)
        self.note("нажмите «Найти устройства»")

        root.after(300, lambda: root.geometry("480x776+0+24"))
        self.refresh()

    def tile(self, parent, text, cb):
        t = tk.Label(parent, text=text, font=("DejaVu Sans", 13, "bold"),
                     bg=KEY, fg="white", pady=14)
        t.pack(side="left", expand=True, fill="both", padx=3)
        t.bind("<Button-1>", lambda _e: (buzz(), cb()))
        return t

    def note(self, text, cb=None):
        row = tk.Label(self.list, text=text, font=("DejaVu Sans", 12),
                       bg="#182238", fg=FG, anchor="w", padx=12, pady=12,
                       wraplength=430, justify="left")
        row.pack(fill="x", pady=3)
        if cb:
            row.bind("<Button-1>", lambda _e: (buzz(), cb()))
        return row

    def clear(self):
        for w in self.list.winfo_children():
            w.destroy()

    # ── действия ──────────────────────────────────────────────────────
    def toggle_power(self):
        if self.busy:
            return
        state, _, _ = bt_state()
        self.busy = True
        if state == "on":
            self.status.config(text="выключаю…")
            threading.Thread(target=lambda: self.done(
                sh("hciconfig hci0 down; echo 0 > "
                   "/sys/class/rfkill/rfkill0/state")), daemon=True).start()
        else:
            self.status.config(text="включаю (заливаю прошивку, ~20 с)…")
            threading.Thread(target=lambda: self.done(
                sh("/usr/local/bin/btsetup")), daemon=True).start()

    def done(self, _out):
        self.busy = False
        self.root.after(0, self.refresh)

    def toggle_vis(self):
        _, _, vis = bt_state()
        sh("hciconfig hci0 %s" % ("noscan" if vis == "да" else "piscan"), 10)
        self.refresh()

    def scan(self):
        if self.busy:
            return
        state, _, _ = bt_state()
        if state != "on":
            self.status.config(text="сначала включите Bluetooth")
            return
        self.busy = True
        self.clear()
        self.note("идёт поиск, 15 секунд…")
        self.b_scan.config(text="ищу…", bg="#8a5a2e")

        def work():
            out = sh("/usr/local/bin/btscan 15", 120)
            self.root.after(0, lambda: self.show(out))
        threading.Thread(target=work, daemon=True).start()

    def show(self, out):
        self.busy = False
        self.b_scan.config(text="🔍  Найти устройства", bg=KEY)
        self.clear()
        lines = [l for l in out.splitlines() if l.strip()]
        if not lines or "не найдено" in out:
            self.note("устройства не найдены — включите видимость "
                      "на другом телефоне и повторите")
            return
        for ln in lines:
            parts = ln.split(None, 2)
            if len(parts) < 3:
                continue
            addr, rssi = parts[0], parts[1]
            name = parts[2].replace("дБм", "").strip()
            self.note("%s\n%s · сигнал %s дБм" % (name or "(без имени)",
                                                  addr, rssi),
                      lambda a=addr: self.connect(a))

    def connect(self, addr):
        self.status.config(text="пробую соединиться с %s…" % addr)

        def work():
            out = sh("timeout 20 hcitool -i hci0 cc %s 2>&1; "
                     "hcitool -i hci0 con" % addr, 40)
            ok = addr.upper() in out.upper()
            self.root.after(0, lambda: self.status.config(
                text=("соединение установлено: %s" % addr) if ok
                else "соединиться не удалось (устройство занято/недоступно)"))
        threading.Thread(target=work, daemon=True).start()

    def refresh(self):
        state, addr, vis = bt_state()
        on = state == "on"
        self.b_power.config(text="Выключить" if on else "Включить",
                            bg=ACC if on else KEY)
        self.b_vis.config(bg=ACC if vis == "да" else KEY,
                          text="Видим" if vis == "да" else "Не видим")
        if on:
            self.status.config(
                text="включён · %s · имя «HTC HD2»\nвидимость: %s"
                % (addr or "?", vis))
        elif not self.busy:
            self.status.config(text="выключен")
        self.root.after(4000, self.refresh)


if __name__ == "__main__":
    _l = open("/tmp/.btapp.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="btapp")
    BtApp(root)
    root.mainloop()
