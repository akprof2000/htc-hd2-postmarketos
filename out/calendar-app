#!/usr/bin/env python3
"""Календарь HTC HD2: месяц крупно, листается."""
import calendar
import datetime
import fcntl
import tkinter as tk

BG, FG, DIM, KEY, TODAY = "#101828", "#e8eef5", "#7c8794", "#1c2a40", "#1f7a33"
MON = ["Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль",
       "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь"]


class Cal:
    def __init__(self, root):
        self.root = root
        today = datetime.date.today()
        self.y, self.m = today.year, today.month
        root.title("Календарь")
        root.configure(bg=BG)
        root.geometry("480x740+0+0")

        nav = tk.Frame(root, bg=BG)
        nav.pack(fill="x", pady=(12, 4))
        tk.Button(nav, text="◀", font=("DejaVu Sans", 18), bg=KEY, fg=FG,
                  relief="flat", bd=0, width=4,
                  command=lambda: self.shift(-1)).pack(side="left", padx=10)
        self.title = tk.Label(nav, text="", font=("DejaVu Sans", 17, "bold"),
                              bg=BG, fg=FG)
        self.title.pack(side="left", expand=True)
        tk.Button(nav, text="▶", font=("DejaVu Sans", 18), bg=KEY, fg=FG,
                  relief="flat", bd=0, width=4,
                  command=lambda: self.shift(1)).pack(side="right", padx=10)

        self.grid = tk.Frame(root, bg=BG)
        self.grid.pack(expand=True, fill="both", padx=8, pady=8)
        self.draw()
        root.after(300, lambda: root.geometry("480x740+0+0"))

    def shift(self, d):
        self.m += d
        if self.m == 0:
            self.m, self.y = 12, self.y - 1
        elif self.m == 13:
            self.m, self.y = 1, self.y + 1
        self.draw()

    def draw(self):
        for w in self.grid.winfo_children():
            w.destroy()
        self.title.config(text="%s %d" % (MON[self.m - 1], self.y))
        today = datetime.date.today()
        for i, d in enumerate(["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"]):
            tk.Label(self.grid, text=d, font=("DejaVu Sans", 12, "bold"),
                     bg=BG, fg="#ef9a9a" if i > 4 else DIM
                     ).grid(row=0, column=i, sticky="nsew")
        for r, week in enumerate(calendar.monthcalendar(self.y, self.m), 1):
            for c, day in enumerate(week):
                if not day:
                    continue
                cur = (day == today.day and self.m == today.month
                       and self.y == today.year)
                tk.Label(self.grid, text=str(day),
                         font=("DejaVu Sans", 16, "bold" if cur else ""),
                         bg=TODAY if cur else KEY,
                         fg="white" if cur else FG
                         ).grid(row=r, column=c, sticky="nsew",
                                padx=2, pady=2)
        for c in range(7):
            self.grid.columnconfigure(c, weight=1)
        for r in range(7):
            self.grid.rowconfigure(r, weight=1 if r else 0)


if __name__ == "__main__":
    _l = open("/tmp/.calapp.lock", "w")
    try:
        fcntl.flock(_l, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    root = tk.Tk(className="calapp")
    Cal(root)
    root.mainloop()
