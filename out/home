#!/usr/bin/env python3
"""IceMobile: домашний экран HTC HD2 — плитки в духе Windows Phone.

Сверху статус: сигнал/тип сети (из /run/phone, кладёт phoned), большие
часы и батарея. Ниже — сетка плиток. «Домой» в панели задач возвращает
сюда из любого приложения.
"""
import fcntl
import os
import subprocess
import time
import tkinter as tk

BG  = "#000000"
FG  = "#ffffff"
DIM = "#9aa4b0"

# плитка: (символ, подпись, цвет, команда, широкая?)
TILES = [
    ("☎", "Телефон",    "#1f7a33", "/usr/local/bin/phone-gui", False),
    ("✉", "СМС",        "#0a6ebd", "/usr/local/bin/phone-sms", False),
    (">_",     "Терминал",   "#4a4a56", "/usr/local/bin/term-max",  False),
    ("▤", "Файлы",      "#8a5a2e", "pcmanfm",                  False),
    ("⌨", "Клава",      "#5133b8", "/usr/local/bin/kbd",       False),
    ("@",      "Браузер",    "#a4262c", "netsurf-gtk3",             False),
    ("☀", "Ярче",       "#217a6b", "/usr/local/bin/backlight +",  False),
    ("☾", "Темнее",     "#1b4a5e", "/usr/local/bin/backlight -",  False),
    ("↻", "Графика",    "#5d5d3a", "/usr/local/bin/x-restart", True),
]


def run(cmd):
    subprocess.Popen(cmd.split(), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def buzz(ms=35):
    """Короткая вибра — тактильный отклик нажатия."""
    try:
        with open("/sys/class/timed_output/vibrator/enable", "w") as f:
            f.write(str(ms))
    except OSError:
        pass


def lighten(color):
    r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % (min(r + 70, 255), min(g + 70, 255),
                              min(b + 70, 255))


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


class Home:
    def __init__(self, root):
        self.root = root
        root.title("Домой")
        root.configure(bg=BG)
        root.geometry("480x740+0+0")

        # ── статус: сигнал слева, батарея справа ──────────────────────
        top = tk.Frame(root, bg=BG)
        top.pack(fill="x", padx=16, pady=(10, 0))
        self.sig = tk.Label(top, text="", font=("DejaVu Sans", 12),
                            bg=BG, fg=DIM, anchor="w")
        self.sig.pack(side="left")
        self.batt = tk.Label(top, text="", font=("DejaVu Sans", 12),
                             bg=BG, fg=DIM, anchor="e")
        self.batt.pack(side="right")

        # ── большие часы + дата (WM 6.5) ──────────────────────────────
        self.clock = tk.Label(root, text="", font=("DejaVu Sans", 44, "bold"),
                              bg=BG, fg=FG)
        self.clock.pack(pady=(2, 0))
        self.date = tk.Label(root, text="", font=("DejaVu Sans", 12),
                             bg=BG, fg=DIM)
        self.date.pack(pady=(0, 8))

        # ── плитки ────────────────────────────────────────────────────
        grid = tk.Frame(root, bg=BG)
        grid.pack(expand=True, fill="both", padx=10, pady=(0, 10))
        row = col = 0
        for sym, name, color, cmd, wide in TILES:
            t = tk.Frame(grid, bg=color)
            span = 2 if wide else 1
            t.grid(row=row, column=col, columnspan=span,
                   sticky="nsew", padx=5, pady=5)
            t.grid_propagate(False)
            # символ в правом верхнем углу, подпись в левом нижнем —
            # на низкой плитке по центру они наезжали друг на друга
            s = tk.Label(t, text=sym, font=("DejaVu Sans", 22, "bold"),
                         bg=color, fg="white")
            s.place(relx=1.0, x=-10, y=6, anchor="ne")
            n = tk.Label(t, text=name, font=("DejaVu Sans", 13, "bold"),
                         bg=color, fg="white")
            n.place(x=10, rely=1.0, y=-6, anchor="sw")
            def tap(_e, c=cmd, frame=t, col=color, sym_l=s, name_l=n):
                # видимый и тактильный отклик: вспышка плитки + вибра
                buzz()
                lit = lighten(col)
                for w in (frame, sym_l, name_l):
                    w.config(bg=lit)
                frame.after(150, lambda: [w.config(bg=col)
                                          for w in (frame, sym_l, name_l)])
                frame.after(60, lambda: run(c))
            for w in (t, s, n):
                w.bind("<Button-1>", tap)
            col += span
            if col >= 2:
                row, col = row + 1, 0
        for c in range(2):
            grid.columnconfigure(c, weight=1, uniform="t")
        for r in range(row + (1 if col else 0)):
            grid.rowconfigure(r, weight=1, uniform="t")

        self.root.after(300, self.fix_place)
        self.root.after(1200, self.fix_place)
        self.tick()

    def fix_place(self):
        self.root.geometry("480x740+0+0")

    def tick(self):
        self.clock.config(text=time.strftime("%H:%M"))
        d = time.strftime("%d.%m.%Y")
        wd = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"][int(
            time.strftime("%w")) - 1]
        self.date.config(text="%s · %s" % (wd, d))

        csq = read("/run/phone/csq")
        n = min(int(csq), 5) if csq.isdigit() else 0
        bars = "".join("▁▂▃▄▅"[i] if i < n else "·"
                       for i in range(5))
        net = read("/run/phone/net").split()
        self.sig.config(text="%s %s" % (bars, net[0] if net else ""))

        cap = read("/sys/class/power_supply/battery/capacity", "?")
        chg = read("/sys/class/power_supply/battery/status")
        flag = "⚡" if chg in ("Charging", "Full") else ""
        self.batt.config(text="%s▮ %s%%" % (flag, cap))

        self.root.after(5000, self.tick)


if __name__ == "__main__":
    _lock = open("/tmp/.home.lock", "w")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit("домашний экран уже запущен")
    root = tk.Tk(className="icehome")
    Home(root)
    root.mainloop()
