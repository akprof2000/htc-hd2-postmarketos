#!/usr/bin/env python3
"""IceMobile: домашний экран HTC HD2.

Сетка крупных кнопок под палец. Живёт на слое Below (winoptions) —
любое открытое приложение ложится поверх, а «Домой» в панели задач
возвращает сюда.
"""
import fcntl
import subprocess
import tkinter as tk

BG   = "#101828"
FG   = "#e8eef5"
TILE = "#1c2a40"
DIM  = "#7c8794"

APPS = [
    ("Телефон",    "#2e5c38", "/usr/local/bin/phone-gui"),
    ("СМС",  "#2e4a66", "/usr/local/bin/phone-sms"),
    ("Терминал",   "#3a3a4a", "/usr/local/bin/term-max"),
    ("Файлы",      "#4a3a2e", "pcmanfm"),
    ("Клавиатура", "#33415c", "/usr/local/bin/kbd"),
    ("Браузер",    "#3c2e4a", "netsurf-gtk3"),
    ("Ярче  ☀+",   "#2a3a4a", "/usr/local/bin/backlight +"),
    ("Темнее ☀−",  "#22303c", "/usr/local/bin/backlight -"),
]


def run(cmd):
    subprocess.Popen(cmd.split(), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def main():
    root = tk.Tk(className="icehome")
    root.title("Домой")
    root.configure(bg=BG)
    root.geometry("480x740+0+0")

    tk.Label(root, text="HTC HD2", font=("DejaVu Sans", 20, "bold"),
             bg=BG, fg=FG).pack(pady=(24, 2))
    tk.Label(root, text="postmarketOS · IceMobile",
             font=("DejaVu Sans", 11), bg=BG, fg=DIM).pack(pady=(0, 12))

    grid = tk.Frame(root, bg=BG)
    grid.pack(expand=True, fill="both", padx=14, pady=(0, 8))
    for i, (name, color, cmd) in enumerate(APPS):
        b = tk.Button(grid, text=name, font=("DejaVu Sans", 14, "bold"),
                      bg=color, fg="white", activebackground="#2a3a4a",
                      relief="flat", bd=0, wraplength=200,
                      command=lambda c=cmd: run(c))
        b.grid(row=i // 2, column=i % 2, sticky="nsew", padx=6, pady=6)
    for c in range(2):
        grid.columnconfigure(c, weight=1)
    for r in range((len(APPS) + 1) // 2):
        grid.rowconfigure(r, weight=1)

    tk.Button(root, text="Перезапустить графику",
              font=("DejaVu Sans", 12), bg=BG, fg=DIM, relief="flat", bd=0,
              command=lambda: run("/usr/local/bin/x-restart")
              ).pack(fill="x", pady=(0, 10))

    def fix_place():
        root.geometry("480x740+0+0")
    root.after(300, fix_place)
    root.after(1200, fix_place)
    root.mainloop()


if __name__ == "__main__":
    _lock = open("/tmp/.home.lock", "w")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit("домашний экран уже запущен")
    main()
