#!/usr/bin/env python3
"""IceMobile: домашний экран HTC HD2 — плитки в духе Windows Phone.

Сверху статус (сигнал, батарея), большие часы. Плитки крупные, их много —
экран листается пальцем вверх/вниз. Тап по плитке: вспышка + вибра.
"""
import fcntl
import os
import subprocess
import time
import tkinter as tk

BG  = "#000000"
FG  = "#ffffff"
DIM = "#9aa4b0"
TILE_H = 118

TILES = [
    ("☎", "Телефон",     "#1f7a33", "/usr/local/bin/phone-gui"),
    ("✉", "СМС",         "#0a6ebd", "/usr/local/bin/phone-sms"),
    ("📷", "Камера",      "#8a2b5a", "/usr/local/bin/camera-app"),
    ("♫", "Медиа",       "#7a4b8a", "/usr/local/bin/media"),
    ("▦", "Приложения",  "#2e6a5a", "/usr/local/bin/taskmgr"),
    ("=", "Калькулятор", "#8a5a2e", "/usr/local/bin/calc"),
    ("✎", "Заметки",     "#4a6b2e", "/usr/local/bin/notes"),
    ("⏰", "Часы",        "#2c5aa4", "/usr/local/bin/clock-app"),
    ("＠", "Почта",       "#a4712c", "/usr/local/bin/mail"),
    ("▧", "Галерея",     "#2e6a8a", "/usr/local/bin/gallery"),
    ("☄", "Фонарик",     "#8a8a2e", "/usr/local/bin/torch"),
    ("⛁", "2048",        "#6a2e8a", "/usr/local/bin/game2048"),
    ("№", "Календарь",   "#a4262c", "/usr/local/bin/calendar-app"),
    ("ᛒ", "Bluetooth",   "#2a4a8a", "/usr/local/bin/btapp"),
    ("⚙", "Настройки",   "#4b5a6a", "/usr/local/bin/settings"),
    ("ℹ", "Система",     "#33415c", "/usr/local/bin/sysinfo"),
    (">_", "Терминал",   "#4a4a56",
     "/usr/local/bin/fitwin Terminal /usr/local/bin/term-max"),
    ("▤", "Файлы",       "#6b5b2e", "/usr/local/bin/fitwin Xfe xfe"),
    ("⌨", "Клава",       "#5133b8", "/usr/local/bin/kbd"),
    ("@", "Браузер",     "#7a2b4b", "/usr/local/bin/fitwin Dillo dillo"),
    ("⏻", "Питание",     "#5d3a3a", "/usr/local/bin/powermenu"),
    ("↻", "Графика",     "#5d5d3a", "/usr/local/bin/x-restart"),
]


def run(cmd):
    subprocess.Popen(cmd.split(), start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def buzz(ms=35):
    try:
        with open("/sys/class/timed_output/vibrator/enable", "w") as f:
            f.write(str(ms))
    except OSError:
        pass


def lighten(color):
    r, g, b = (int(color[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % (min(r + 70, 255), min(g + 70, 255),
                              min(b + 70, 255))


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


class Home:
    def __init__(self, root):
        self.root = root
        root.title("Домой")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")

        self.clock = tk.Label(root, text="", font=("DejaVu Sans", 40, "bold"),
                              bg=BG, fg=FG)
        self.clock.pack()
        self.date = tk.Label(root, text="", font=("DejaVu Sans", 12),
                             bg=BG, fg=DIM)
        self.date.pack(pady=(0, 6))

        # ── прокручиваемое поле плиток ────────────────────────────────
        self.canvas = tk.Canvas(root, bg=BG, highlightthickness=0)
        self.canvas.pack(expand=True, fill="both")
        self.inner = tk.Frame(self.canvas, bg=BG)
        self.canvas.create_window((0, 0), window=self.inner, anchor="nw",
                                  width=480)

        self.drag = {"y": 0, "moved": False}
        for i, (sym, name, color, cmd) in enumerate(TILES):
            t = tk.Frame(self.inner, bg=color, height=TILE_H, width=225)
            t.grid(row=i // 2, column=i % 2, sticky="nsew", padx=5, pady=5)
            t.grid_propagate(False)
            s = tk.Label(t, text=sym, font=("DejaVu Sans", 20, "bold"),
                         bg=color, fg="white")
            s.place(relx=1.0, x=-10, y=6, anchor="ne")
            n = tk.Label(t, text=name, font=("DejaVu Sans", 13, "bold"),
                         bg=color, fg="white")
            n.place(x=10, rely=1.0, y=-6, anchor="sw")
            for w in (t, s, n):
                w.bind("<ButtonPress-1>", self.press)
                w.bind("<B1-Motion>", self.motion)
                w.bind("<ButtonRelease-1>",
                       lambda e, c=cmd, fr=t, co=color, a=s, b=n:
                       self.release(e, c, fr, co, a, b))
        for c in range(2):
            self.inner.columnconfigure(c, weight=1, minsize=235)
        self.inner.update_idletasks()
        self.canvas.config(scrollregion=(0, 0, 480,
                                         self.inner.winfo_reqheight()))
        self.canvas.bind("<ButtonPress-1>", self.press)
        self.canvas.bind("<B1-Motion>", self.motion)

        self.root.after(300, self.fix_place)
        self.root.after(1200, self.fix_place)
        self.tick()

    # ── прокрутка пальцем ─────────────────────────────────────────────
    def press(self, e):
        self.drag = {"y": e.y_root, "moved": False}

    def motion(self, e):
        dy = e.y_root - self.drag["y"]
        if abs(dy) > 12:
            self.drag["moved"] = True
            self.canvas.yview_scroll(-dy // 12 or (-1 if dy > 0 else 1),
                                     "units")
            self.drag["y"] = e.y_root

    def release(self, _e, cmd, frame, color, sym_l, name_l):
        if self.drag["moved"]:
            return                       # это была прокрутка, не тап
        buzz()
        lit = lighten(color)
        for w in (frame, sym_l, name_l):
            w.config(bg=lit)
        frame.after(150, lambda: [w.config(bg=color)
                                  for w in (frame, sym_l, name_l)])
        frame.after(60, lambda: run(cmd))

    def fix_place(self):
        self.root.geometry("480x776+0+24")

    def tick(self):
        self.clock.config(text=time.strftime("%H:%M"))
        wd = ["пн", "вт", "ср", "чт", "пт", "сб", "вс"][int(
            time.strftime("%w")) - 1]
        self.date.config(text="%s · %s" % (wd, time.strftime("%d.%m.%Y")))

        self.root.after(5000, self.tick)


if __name__ == "__main__":
    _lock = open("/tmp/.home.lock", "w")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit("домашний экран уже запущен")
    root = tk.Tk(className="icehome")
    Home(root)
    root.mainloop()
