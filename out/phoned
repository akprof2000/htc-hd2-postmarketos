#!/usr/bin/env python3
"""Демон модема HTC HD2.

Канал /dev/smd0 может держать открытым только один процесс, поэтому демон
владеет им единолично: читает события модема, раскладывает состояние по
файлам и принимает команды из очереди. Интерфейс с модемом напрямую не
разговаривает — только через этот демон.

Демон же управляет и голосовым трактом: при переходе в разговор запускает
`voice on`, при завершении — `voice off`. Интерфейсу звук не принадлежит.

Состояние в /run/phone/:
    state    — idle | ringing | active | dialing
    number   — номер собеседника (если известен)
    route    — handset | headset (куда идёт звук разговора)
    mute     — 0 | 1 (микрофон)
    log      — последние события, для отладки
    cmd      — очередь (FIFO): AT-команды, либо служебные "@route h",
               "@mute 1", "@vol 80"
    sms      — принятые сообщения, по одному на строку

История вызовов копится в /var/lib/phone/history:
    время;направление(in/out);номер;итог(ok/missed/busy);длительность_сек
"""
import fcntl
import os
import re
import select
import struct
import subprocess
import sys
import time

DEV = "/dev/smd0"
RUN = "/run/phone"
CMD = os.path.join(RUN, "cmd")
HISTDIR = "/var/lib/phone"
HIST = os.path.join(HISTDIR, "history")
AUDIOCTL = "/dev/msm_audio_ctl"

# _IOW('a', nr, unsigned): dir=write(1)<<30 | size<<16 | 'a'<<8 | nr
def _iow(nr, size=4):
    return (1 << 30) | (size << 16) | (ord('a') << 8) | nr

AUDIO_SET_VOLUME    = _iow(10)
AUDIO_SWITCH_DEVICE = _iow(32)
AUDIO_SET_MUTE      = _iow(33)

# идентификаторы устройств ADSP (как в voice.c)
DEV_HANDSET_SPKR = 0x1081511
DEV_HANDSET_MIC  = 0x1081512
DEV_HEADSET_SPKR = 0x107ac8a
DEV_HEADSET_MIC  = 0x1081510
DEV_SPKR_MONO    = 0x1081513   # громкий динамик (работает от beep)


def setup():
    os.makedirs(RUN, exist_ok=True)
    os.makedirs(HISTDIR, exist_ok=True)
    if not os.path.exists(DEV):
        os.system("mknod %s c 253 0" % DEV)
    # сырой режим: модем шлёт строки как есть
    subprocess.run(["stty", "-F", DEV, "raw", "-echo"],
                   stderr=subprocess.DEVNULL)
    if not os.path.exists(CMD):
        os.mkfifo(CMD, 0o666)
    write("state", "idle")
    write("number", "")
    # динамик: трубочный динамик пока молчит (усилитель не включается),
    # а громкий проверен разговором
    write("route", "speaker")
    write("mute", "0")


def write(name, value):
    tmp = os.path.join(RUN, name + ".tmp")
    with open(tmp, "w") as f:
        f.write(value)
    os.replace(tmp, os.path.join(RUN, name))


def read_state(name, default=""):
    try:
        with open(os.path.join(RUN, name)) as f:
            return f.read().strip()
    except OSError:
        return default


def log(line):
    with open(os.path.join(RUN, "log"), "a") as f:
        f.write("%s %s\n" % (time.strftime("%H:%M:%S"), line))
    try:
        p = os.path.join(RUN, "log")
        if os.path.getsize(p) > 100000:
            lines = open(p).readlines()[-200:]
            open(p, "w").writelines(lines)
    except OSError:
        pass


def audio_ioctl(req, *words):
    """ioctl на /dev/msm_audio_ctl со структурой из u32."""
    try:
        with open(AUDIOCTL, "wb") as f:
            fcntl.ioctl(f, req, struct.pack("%dI" % len(words), *words))
        return True
    except OSError as e:
        log("audio ioctl %x: %r" % (req, e))
        return False


class Audio:
    """Голосовой тракт: запуск/останов через бинарь voice (проверен),
    маршрут/микрофон/громкость — ioctl-ами на лету."""
    def __init__(self):
        self.on = False

    def start(self):
        if self.on:
            return
        h = "h" if read_state("route") == "headset" else ""
        subprocess.run(["/usr/local/bin/voice", "on"] + ([h] if h else []),
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.on = True
        self.apply_route()
        self.apply_mute()
        log("голос: включён")

    def stop(self):
        if not self.on:
            return
        subprocess.run(["/usr/local/bin/voice", "off"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.on = False
        log("голос: выключен")

    def apply_route(self):
        if not self.on:
            return
        route = read_state("route")
        rx, tx = {
            "headset": (DEV_HEADSET_SPKR, DEV_HEADSET_MIC),
            "speaker": (DEV_SPKR_MONO,    DEV_HANDSET_MIC),
        }.get(route, (DEV_HANDSET_SPKR, DEV_HANDSET_MIC))
        audio_ioctl(AUDIO_SWITCH_DEVICE, rx, 0)
        audio_ioctl(AUDIO_SWITCH_DEVICE, tx, 0)
        log("маршрут: %s" % (route or "handset"))

    def apply_mute(self):
        if not self.on:
            return
        audio_ioctl(AUDIO_SET_MUTE, 1 if read_state("mute") == "1" else 0)

    def volume(self, v):
        audio_ioctl(AUDIO_SET_VOLUME, max(0, min(100, v)))


class Ringer:
    """Рингтон: короткие гудки в динамик, пока идёт входящий."""
    def __init__(self):
        self.proc = None
        self.last = 0.0

    def tick(self, ringing):
        if not ringing:
            return
        now = time.monotonic()
        if now - self.last < 2.5:
            return
        if self.proc and self.proc.poll() is None:
            return
        self.last = now
        try:
            self.proc = subprocess.Popen(
                ["/usr/local/bin/beep", "s", "100"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            pass


class Calls:
    """Состояние вызова + история."""
    def __init__(self, audio, modem_write):
        self.audio = audio
        self.modem_write = modem_write
        self.state = "idle"
        self.number = ""
        self.direction = ""      # in / out
        self.started = 0.0       # начало разговора (active)
        self.appeared = 0.0      # появление вызова (ringing/dialing)
        self.answered = False

    def set_state(self, st):
        if st == self.state:
            return
        old, self.state = self.state, st
        write("state", st)
        log("состояние: %s -> %s" % (old, st))

        if st == "ringing" and old == "idle":
            self.direction, self.answered = "in", False
            self.appeared = time.time()
        if st == "dialing" and old == "idle":
            self.direction, self.answered = "out", False
            self.appeared = time.time()

        # голос включаем уже на наборе: гудки «вызов идёт» сеть передаёт
        # по голосовому каналу до ответа абонента
        if st == "dialing" and self.direction == "out":
            self.audio.start()
        if st == "active":
            self.answered = True
            self.started = time.time()
            self.audio.start()
        elif st == "idle":
            self.audio.stop()

        if st == "idle" and old != "idle":
            self.finish(old)

    def finish(self, old):
        dur = int(time.time() - self.started) if self.answered else 0
        if self.answered:
            outcome = "ok"
        elif self.direction == "in":
            outcome = "missed"
        else:
            outcome = "busy"
        if self.number or self.direction:
            try:
                with open(HIST, "a") as f:
                    f.write("%s;%s;%s;%s;%d\n" % (
                        time.strftime("%d.%m %H:%M"), self.direction or "?",
                        self.number or "?", outcome, dur))
            except OSError:
                pass
        self.number = ""
        self.direction = ""
        write("number", "")


def main():
    setup()
    fd = os.open(DEV, os.O_RDWR | os.O_NONBLOCK)
    # O_RDWR, а не O_RDONLY: иначе при отсутствии писателей очередь всё время
    # сообщает "конец файла", select срабатывает вхолостую и демон уходит в
    # бесконечный цикл, съедая процессор. Открытый на запись конец не даёт EOF.
    cmdfd = os.open(CMD, os.O_RDWR | os.O_NONBLOCK)

    def modem(cmd):
        log("-> " + cmd)
        os.write(fd, (cmd + "\r").encode())

    audio = Audio()
    ringer = Ringer()
    calls = Calls(audio, modem)

    # приветствие модему: определитель номера, расширенный RING, текстовые SMS.
    # Последними — посадка на 2G: на слабом 3G пейджинг теряется («абонент
    # недоступен»), WS46 модем игнорирует, работает только ручной COPS с AcT=0.
    for at in ("ATV1", "AT+CLIP=1", "AT+CRC=1", "AT+CMGF=1",
               "AT+CNMI=2,1,0,0,0", "AT+WS46=12",
               'AT+COPS=1,2,"25002",0'):
        modem(at)
        time.sleep(0.4)

    def internal(cmd):
        """Служебные команды из очереди: @route/@mute/@vol."""
        parts = cmd.split()
        if parts[0] == "@route" and len(parts) > 1:
            write("route", {"h": "headset", "l": "speaker"}.get(
                parts[1][:1], "handset"))
            audio.apply_route()
        elif parts[0] == "@mute" and len(parts) > 1:
            write("mute", "1" if parts[1] == "1" else "0")
            audio.apply_mute()
        elif parts[0] == "@vol" and len(parts) > 1:
            try:
                audio.volume(int(parts[1]))
            except ValueError:
                pass

    # pending["clcc"] — ждём ответ на AT+CLCC; если пришёл OK, а строк
    # +CLCC не было, значит вызовов не осталось — состояние idle.
    pending = {"clcc": False, "seen": False}

    def handle(line):
        if not line:
            return
        log("<- " + line)

        if line == "OK" and pending["clcc"]:
            if not pending["seen"] and calls.state != "idle":
                calls.set_state("idle")
            pending["clcc"] = pending["seen"] = False

        if line.startswith("+CRING") or line == "RING":
            calls.set_state("ringing")

        m = re.match(r'\+CLIP:\s*"([^"]*)"', line)
        if m:
            calls.number = m.group(1)
            write("number", calls.number)

        # состояние вызовов: +CLCC: id,dir,stat,mode,mpty,"номер",тип
        m = re.match(r'\+CLCC:\s*\d+,(\d+),(\d+),\d+,\d+(?:,"([^"]*)")?', line)
        if m:
            pending["seen"] = True
            stat = m.group(2)
            if m.group(3) and not calls.number:
                calls.number = m.group(3)
                write("number", calls.number)
            calls.set_state({"0": "active", "1": "dialing", "2": "dialing",
                             "3": "dialing", "4": "ringing",
                             "5": "ringing"}.get(stat, "active"))

        if line in ("NO CARRIER", "BUSY", "NO ANSWER", "NO DIALTONE"):
            calls.set_state("idle")

        # уровень сигнала: @HTCCSQ модем шлёт сам, шкала ~0..5
        m = re.match(r'@HTCCSQ:\s*(\d+)', line)
        if m:
            write("csq", m.group(1))

        # точный уровень: +CSQ: n,ber; n=0..31 -> дБм = -113 + 2n
        m = re.match(r'\+CSQ:\s*(\d+)', line)
        if m:
            n = int(m.group(1))
            write("dbm", str(-113 + 2 * n) if n < 99 else "")

        # тип сети из +COPS: mode,fmt,"оператор",AcT
        m = re.match(r'\+COPS:\s*\d+,\d+,"([^"]*)",(\d+)', line)
        if m:
            act = {"0": "GSM", "1": "GSM", "2": "3G", "3": "EDGE",
                   "4": "3G+", "5": "3G+", "6": "3G+", "7": "LTE"}
            write("net", "%s %s" % (act.get(m.group(2), "?"), m.group(1)))

        # NITZ: время с вышки — +HTCCTZV: "гг/мм/дд,чч:мм:сс+смещ",
        # смещение в четвертях часа. Правим системные часы при уходе >2 мин.
        m = re.match(r'\+HTCCTZV:\s*"(\d+)/(\d+)/(\d+),(\d+):(\d+):(\d+)'
                     r'([+-]\d+)', line)
        if m:
            y, mo, d, h, mi, s = (int(x) for x in m.groups()[:6])
            off = int(m.group(7)) * 900          # четверти часа -> секунды
            # NITZ-время локальное; минус смещение = UTC
            import calendar
            try:
                utc = calendar.timegm((2000 + y, mo, d, h, mi, s)) - off
            except (ValueError, OverflowError):
                return
            if abs(utc - time.time()) > 120:
                subprocess.run(["date", "-u", "-s", time.strftime(
                    "%Y-%m-%d %H:%M:%S", time.gmtime(utc))],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                subprocess.run(["hwclock", "-w", "-u"],
                               stderr=subprocess.DEVNULL)
                log("время синхронизировано с вышкой")

        m = re.match(r'\+CMTI:\s*"?(\w+)"?,(\d+)', line)
        if m:
            with open(os.path.join(RUN, "sms_new"), "a") as f:
                f.write("%s %s\n" % (m.group(1), m.group(2)))

    buf = b""
    cmdbuf = b""
    last_clcc = 0.0
    last_netpoll = 0.0
    while True:
        r, _, _ = select.select([fd, cmdfd], [], [], 1.0)

        if cmdfd in r:
            try:
                chunk = os.read(cmdfd, 4096)
            except OSError:
                chunk = b""
            if chunk:
                cmdbuf += chunk
                while b"\n" in cmdbuf:
                    line, cmdbuf = cmdbuf.split(b"\n", 1)
                    cmd = line.decode(errors="replace").strip()
                    if not cmd:
                        continue
                    if cmd.startswith("@"):
                        internal(cmd)
                    else:
                        # OK от этой команды не должен сойти за пустой
                        # ответ на наш опрос CLCC
                        pending["clcc"] = False
                        modem(cmd)
                        up = cmd.upper()
                        if up.startswith("ATD"):
                            # V.250: любой символ во время набора прерывает
                            # его — не слать модему ничего первые секунды
                            last_clcc = time.monotonic() + 2.0
                            calls.number = cmd[3:].rstrip(";")
                            write("number", calls.number)
                            calls.set_state("dialing")
                        elif up.startswith(("ATA", "ATH")):
                            # то же при ответе и отбое: CLCC сразу после
                            # ATA обрывал установку соединения
                            last_clcc = time.monotonic() + 2.0
            # EOF здесь не бывает: очередь открыта и на запись

        if fd in r:
            try:
                chunk = os.read(fd, 4096)
            except OSError:
                chunk = b""
            if chunk:
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    handle(line.decode(errors="replace").strip())

        # пока вызов жив — сами держим состояние в курсе, GUI не обязан
        now = time.monotonic()
        if calls.state != "idle" and now - last_clcc > 2.0:
            last_clcc = now
            pending["clcc"], pending["seen"] = True, False
            modem("AT+CLCC")
        # в покое раз в 25 с спрашиваем точный сигнал и тип сети
        if calls.state == "idle" and now - last_netpoll > 25.0:
            last_netpoll = now
            modem("AT+CSQ")
            modem("AT+COPS?")
        ringer.tick(calls.state == "ringing")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
    except Exception as e:  # демон не должен умирать молча
        log("ОШИБКА: %r" % (e,))
        sys.exit(1)
