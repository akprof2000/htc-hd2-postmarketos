#!/bin/sh
# Экранная клавиатура — переключатель. rukbd (своя, с русским) печатает в
# активное окно через xdotool, окно фокус не забирает.
export DISPLAY=${DISPLAY:-:0}
if pgrep -f 'bin/rukbd' >/dev/null 2>&1; then
    pkill -f 'bin/rukbd'
    echo 'клавиатура скрыта'
else
    setsid /usr/local/bin/rukbd </dev/null >/dev/null 2>&1 &
    echo 'клавиатура показана'
fi
