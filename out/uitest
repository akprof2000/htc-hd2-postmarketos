#!/bin/sh
# Прогонщик проверок интерфейса. Один вызов вместо десятка: запускает
# приложение, ждёт окно, делает тапы, снимает экран и закрывает окно.
#
# ЗАЧЕМ: проверять по одному действию за подключение — долго, а любой
# шаг может подвиснуть (xdotool на мёртвом X, окно, которое не
# появилось, снимок при зависшей графике). Поэтому КАЖДЫЙ шаг здесь
# обёрнут в timeout, а ожидание окна ограничено по времени. Прогонщик
# всегда завершается и всегда печатает отчёт.
#
# Запуск:  uitest <программа> <заголовок> [x,y ...]
# Пример:  uitest game2048 2048 240,400 240,250
#
# Печатает строки вида «окно: есть», «тап 240,400: ок», «снимок: 25 КБ»,
# «закрытие: ок». Снимок остаётся в /tmp/shot.png.

export DISPLAY=:0
BIN=$1
TITLE=$2
shift 2

say() { echo "$1"; }

# 1. поднять приложение (старый замок мешает единственной копии)
rm -f /tmp/.$(basename "$BIN").lock 2>/dev/null
timeout 10 start-stop-daemon -b -S -x "/usr/local/bin/$BIN" 2>/dev/null

# 2. дождаться окна, но не дольше 12 секунд
n=0
while [ $n -lt 24 ]; do
    if timeout 5 wmctrl -l 2>/dev/null | grep -q "$TITLE"; then
        say "окно: есть"
        break
    fi
    n=$((n + 1))
    sleep 0.5
done
if [ $n -ge 24 ]; then
    say "окно: НЕ ПОЯВИЛОСЬ за 12 с"
    exit 1
fi
sleep 1                       # дать первую отрисовку

# 3. тапы
for p in "$@"; do
    x=${p%,*}; y=${p#*,}
    if timeout 5 xdotool mousemove "$x" "$y" click 1 2>/dev/null; then
        say "тап $x,$y: ок"
    else
        say "тап $x,$y: НЕ ПРОШЁЛ"
    fi
    sleep 1
done

# 4. снимок (сам по себе не вешается: читает /dev/fb0, не трогая X)
if timeout 25 /usr/local/bin/shot 2>/dev/null; then
    say "снимок: $(( $(wc -c < /tmp/shot.png) / 1024 )) КБ"
else
    say "снимок: НЕ СНЯЛСЯ"
fi

# 5. закрыть и убедиться, что окно ушло
timeout 5 wmctrl -c "$TITLE" 2>/dev/null
sleep 2
if timeout 5 wmctrl -l 2>/dev/null | grep -q "$TITLE"; then
    say "закрытие: ОКНО ОСТАЛОСЬ"
else
    say "закрытие: ок"
fi
