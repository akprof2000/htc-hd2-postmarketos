#!/usr/bin/env python3
"""Звонилка HTC HD2 — интерфейс.

С модемом напрямую не разговаривает: читает состояние из /run/phone/ и шлёт
команды демону через очередь. Голосовым трактом тоже управляет демон — GUI
только просит (@route/@mute). Так канал модема и звук у одного владельца.

Экран 480x800, всё под палец: цифры крупные, кнопки высокие.
"""
import os
import time
import tkinter as tk

RUN = "/run/phone"
CMD = os.path.join(RUN, "cmd")
HIST = "/var/lib/phone/history"

BG      = "#101418"
FG      = "#e8eef5"
DIM     = "#7c8794"
ACCENT  = "#2e7d32"   # зелёный — принять/позвонить
DANGER  = "#c62828"   # красный — сброс
KEY     = "#1c2530"
WARN    = "#ffa726"


def send(line):
    """Отдать команду демону."""
    try:
        with open(CMD, "w") as f:
            f.write(line + "\n")
    except OSError:
        pass


def read(name, default=""):
    try:
        with open(os.path.join(RUN, name)) as f:
            return f.read().strip()
    except OSError:
        return default


class Phone:
    def __init__(self, root):
        self.root = root
        self.typed = ""
        self.state = "idle"
        self.call_start = None
        self.muted = False

        root.title("Телефон")
        root.configure(bg=BG)
        root.geometry("480x776+0+24")

        # ── постоянный индикатор сети (как в смартфонах) ──────────────
        # ── строка состояния ──────────────────────────────────────────
        self.status = tk.Label(root, text="", font=("DejaVu Sans", 11),
                               bg=BG, fg=DIM, anchor="w", padx=12)
        self.status.pack(fill="x")

        # ── номер / таймер ────────────────────────────────────────────
        self.display = tk.Label(root, text="", font=("DejaVu Sans", 26, "bold"),
                                bg=BG, fg=FG, height=2)
        self.display.pack(fill="x")

        # ── клавиатура (в разговоре шлёт DTMF) ────────────────────────
        self.pad = tk.Frame(root, bg=BG)
        self.pad.pack(expand=True, fill="both", padx=8)
        for i, d in enumerate("123456789*0#"):
            b = tk.Button(self.pad, text=d, font=("DejaVu Sans", 22),
                          bg=KEY, fg=FG, activebackground="#2a3a4a",
                          relief="flat", bd=0,
                          command=lambda x=d: self.press(x))
            b.grid(row=i // 3, column=i % 3, sticky="nsew", padx=4, pady=4)
        for c in range(3):
            self.pad.columnconfigure(c, weight=1)
        for r in range(4):
            self.pad.rowconfigure(r, weight=1)

        # ── кнопки разговора (видны только в active) ──────────────────
        self.tools = tk.Frame(root, bg=BG)
        self.btn_mute = tk.Button(self.tools, text="Микрофон вкл",
                                  font=("DejaVu Sans", 12), bg=KEY, fg=FG,
                                  relief="flat", bd=0, height=2,
                                  command=self.toggle_mute)
        self.btn_mute.pack(side="left", expand=True, fill="both", padx=(0, 4))
        self.btn_route = tk.Button(self.tools, text="Трубка",
                                   font=("DejaVu Sans", 12), bg=KEY, fg=FG,
                                   relief="flat", bd=0, height=2,
                                   command=self.toggle_route)
        self.btn_route.pack(side="left", expand=True, fill="both", padx=(4, 0))

        # ── кнопки действий ───────────────────────────────────────────
        bar = tk.Frame(root, bg=BG)
        bar.pack(fill="x", padx=8, pady=8)

        self.btn_call = tk.Button(bar, text="Позвонить",
                                  font=("DejaVu Sans", 15, "bold"),
                                  bg=ACCENT, fg="white", relief="flat", bd=0,
                                  height=2, command=self.call)
        self.btn_call.pack(side="left", expand=True, fill="both", padx=(0, 4))

        self.btn_hang = tk.Button(bar, text="Сброс",
                                  font=("DejaVu Sans", 15, "bold"),
                                  bg=DANGER, fg="white", relief="flat", bd=0,
                                  height=2, command=self.hangup)
        self.btn_hang.pack(side="left", expand=True, fill="both", padx=(4, 0))

        low = tk.Frame(root, bg=BG)
        low.pack(fill="x", pady=(0, 6))
        tk.Button(low, text="◀ стереть", font=("DejaVu Sans", 12),
                  bg=BG, fg=DIM, relief="flat", bd=0,
                  command=self.backspace).pack(side="left", expand=True,
                                               fill="x")
        tk.Button(low, text="Журнал", font=("DejaVu Sans", 12),
                  bg=BG, fg=DIM, relief="flat", bd=0,
                  command=self.show_history).pack(side="left", expand=True,
                                                  fill="x")

        # ── журнал вызовов (поверх всего) ─────────────────────────────
        self.hist = tk.Frame(root, bg=BG)
        tk.Label(self.hist, text="Журнал вызовов",
                 font=("DejaVu Sans", 14, "bold"), bg=BG, fg=FG
                 ).pack(pady=(10, 4))
        self.histlist = tk.Listbox(self.hist, font=("DejaVu Sans Mono", 11),
                                   bg=KEY, fg=FG, selectbackground="#2a3a4a",
                                   relief="flat", bd=0, activestyle="none")
        self.histlist.pack(expand=True, fill="both", padx=8)
        self.histlist.bind("<ButtonRelease-1>", self.pick_history)
        tk.Button(self.hist, text="Закрыть", font=("DejaVu Sans", 13),
                  bg=KEY, fg=FG, relief="flat", bd=0, height=2,
                  command=self.hist.place_forget).pack(fill="x", padx=8,
                                                       pady=8)

        self.root.after(300, self.fix_place)
        self.root.after(1200, self.fix_place)
        self.tick()

    def fix_place(self):
        """IceWM ставит окно со сдвигом — возвращаем в левый верхний угол,
        иначе правый край уезжает за экран."""
        self.root.geometry("480x776+0+24")

    # ── действия ──────────────────────────────────────────────────────
    def press(self, d):
        if self.state == "idle":
            self.typed += d
            self.refresh()
        elif self.state == "active":
            send("AT+VTS=%s" % d)            # тоновый набор в разговоре

    def backspace(self):
        self.typed = self.typed[:-1]
        self.refresh()

    def call(self):
        if self.state == "ringing":
            send("ATA")                      # принять входящий
        elif self.state == "idle" and self.typed:
            send("ATD%s;" % self.typed)      # набрать

    def hangup(self):
        send("ATH")
        self.typed = ""

    def toggle_mute(self):
        self.muted = not self.muted
        send("@mute %d" % self.muted)
        self.btn_mute.config(
            text="Микрофон ВЫКЛ" if self.muted else "Микрофон вкл",
            fg=WARN if self.muted else FG)

    def toggle_route(self):
        # цикл: трубка -> громкий динамик -> гарнитура -> трубка
        nxt = {"handset": ("l", "Динамик"),
               "speaker": ("h", "Гарнитура")}.get(read("route"),
                                                  ("s", "Трубка"))
        send("@route %s" % nxt[0])
        self.btn_route.config(text=nxt[1])

    # ── журнал ────────────────────────────────────────────────────────
    def show_history(self):
        try:                             # журнал просмотрен — значок гаснет
            with open(os.path.join(RUN, "missed"), "w") as f:
                f.write("0")
        except OSError:
            pass
        self.histlist.delete(0, "end")
        self.numbers = []
        try:
            rows = open(HIST).readlines()[-40:]
        except OSError:
            rows = []
        mark = {"in": "←", "out": "→"}
        for row in reversed(rows):
            p = row.strip().split(";")
            if len(p) < 5:
                continue
            when, dirn, num, outcome, dur = p[:5]
            extra = "пропущен" if outcome == "missed" else (
                "%s:%02d" % (int(dur) // 60, int(dur) % 60)
                if outcome == "ok" else "не состоялся")
            self.histlist.insert(
                "end", " %s %s %-15s %s" % (mark.get(dirn, "?"), when,
                                            num, extra))
            self.numbers.append(num)
            if outcome == "missed":
                self.histlist.itemconfig("end", fg=WARN)
        if not rows:
            self.histlist.insert("end", "  журнал пуст")
            self.numbers.append("")
        self.hist.place(x=0, y=0, relwidth=1, relheight=1)

    def pick_history(self, _ev):
        sel = self.histlist.curselection()
        if sel and sel[0] < len(self.numbers):
            num = self.numbers[sel[0]].strip()
            if num and num not in ("?",):
                self.typed = num
                self.hist.place_forget()
                self.refresh()

    # ── обновление ────────────────────────────────────────────────────
    def refresh(self):
        if self.state == "idle":
            self.display.config(text=self.typed or "—", fg=FG)
        elif self.state == "active" and self.call_start:
            d = int(time.time() - self.call_start)
            self.display.config(
                text="%s\n%d:%02d" % (read("number") or "разговор",
                                      d // 60, d % 60), fg=FG)
        else:
            self.display.config(text=read("number") or "неизвестный", fg=FG)

    def net_line(self):
        csq = read("csq")
        if not csq:
            return "нет связи с модемом"
        n = min(int(csq), 5)
        bars = "".join("▁▂▃▄▅"[i] if i < n else "·" for i in range(5))
        dbm = read("dbm")
        net = read("net")          # напр. "3G North-West GSM"
        parts = [bars]
        if dbm:
            parts.append(dbm + " дБм")
        if net:
            parts.append(net)
        return "  ".join(parts)

    def tick(self):
        st = read("state", "idle")
        if st != self.state:
            self.state = st
            self.on_state()
        # сеть показывает статус-полоска сверху — здесь не дублируем
        self.refresh()
        self.root.after(700, self.tick)

    def on_state(self):
        if self.state == "active":
            self.call_start = time.time()
            self.tools.pack(fill="x", padx=8, before=self.btn_call.master)
        else:
            self.call_start = None
            self.tools.pack_forget()
            if self.muted:               # к новому разговору — с микрофоном
                self.toggle_mute()

        if self.state == "ringing":
            self.status.config(text="ВХОДЯЩИЙ ВЫЗОВ", fg="#66bb6a")
            self.btn_call.config(text="Ответить")
        elif self.state == "active":
            self.status.config(text="Разговор  ·  цифры шлют тоны", fg=WARN)
            self.btn_call.config(text="—")
        elif self.state == "dialing":
            self.status.config(text="Набор…", fg=WARN)
            self.btn_call.config(text="—")
        else:
            self.status.config(text="Готов", fg=DIM)
            self.btn_call.config(text="Позвонить")


if __name__ == "__main__":
    # вторая копия окна дробит экран пополам — не даём ей запуститься
    import fcntl
    _lock = open("/run/phone/gui.lock", "w")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit("звонилка уже запущена")
    root = tk.Tk()
    Phone(root)
    root.mainloop()
